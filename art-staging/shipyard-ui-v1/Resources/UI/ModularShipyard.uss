.yard {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    color: rgb(231, 241, 246);
    background-color: rgb(22, 43, 57);
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.yard Button {
    min-height: 44px;
    min-width: 44px;
    margin: 3px;
    padding: 6px 12px;
    border-width: 1px;
    border-color: rgb(101, 136, 154);
    border-radius: 5px;
    background-color: rgb(31, 57, 72);
    color: rgb(231, 241, 246);
    font-size: 16px;
    flex-shrink: 0;
}
.yard Button:hover { background-color: rgb(48, 79, 96); }
.yard Button:focus { border-color: rgb(177, 227, 247); border-width: 2px; }
.yard Button:disabled { opacity: 0.45; }
.yard-header { flex-direction: row; align-items: center; height: 58px; flex-shrink: 0; padding: 0 8px; border-bottom-width: 1px; border-bottom-color: rgb(101, 136, 154); }
.yard-title { flex-grow: 1; -unity-text-align: middle-center; font-size: 25px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Fraunces-Black.ttf"); }
.yard-body { flex-grow: 1; min-height: 0; }
.yard-viewport { flex-grow: 1; min-height: 120px; overflow: hidden; background-color: rgb(71, 100, 113); }
.yard-render { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.yard-badge { position: absolute; left: 12px; top: 12px; background-color: rgb(22, 43, 57); color: rgb(177, 227, 247); padding: 5px 9px; font-size: 12px; border-radius: 3px; }
.yard-views { position: absolute; right: 8px; top: 8px; }
.yard Button.yard-icon-button { width: 44px; height: 44px; padding: 10px; }
.yard-icon { width: 24px; height: 24px; flex-shrink: 0; }
.yard-panel { height: 340px; flex-shrink: 0; border-top-width: 1px; border-top-color: rgb(101, 136, 154); }
.yard-options { flex-grow: 1; min-height: 0; padding: 12px 12px 0 12px; }
.yard-heading { font-size: 20px; margin-bottom: 8px; }
.yard-length { flex-direction: row; align-items: center; }
.yard-length-title { flex-grow: 1; }
.yard-count { width: 26px; -unity-text-align: middle-center; font-size: 20px; }
.yard-measure { color: rgb(171, 209, 226); margin-top: 2px; margin-bottom: 10px; }
.yard-details { white-space: normal; font-size: 13px; color: rgb(191, 205, 211); margin: 12px 0; flex-shrink: 0; }
.yard-caption { color: rgb(173, 194, 205); font-size: 13px; }
.yard-wheels { flex-direction: row; }
.yard-wheels Button { flex-grow: 1; flex-basis: 0; }
.yard Button.yard-selected { border-color: rgb(171, 223, 246); background-color: rgb(48, 83, 102); }
.yard-message { color: rgb(191, 205, 211); font-size: 13px; white-space: normal; margin: 4px 12px 0 12px; min-height: 18px; max-height: 54px; flex-shrink: 0; }
.yard-options .unity-scroller--vertical { width: 6px; margin-left: 4px; }
.yard-options .unity-scroller__low-button, .yard-options .unity-scroller__high-button { display: none; }
.yard-options .unity-base-slider__tracker { background-color: rgb(31, 57, 72); border-width: 0; }
.yard-options .unity-base-slider__dragger { background-color: rgb(101, 136, 154); border-width: 0; border-radius: 3px; }
.yard-footer { flex-direction: row; padding: 8px; flex-shrink: 0; }
.yard-footer Button { flex-grow: 1; flex-basis: 0; }
.yard-footer Button.yard-confirm { flex-grow: 2; background-color: rgb(171, 218, 239); color: rgb(22, 43, 57); }
.yard-wide .yard-body { flex-direction: row; }
.yard-wide .yard-panel { width: 330px; height: auto; border-top-width: 0; border-left-width: 1px; border-left-color: rgb(101, 136, 154); }
.yard-wide .yard-viewport { min-width: 200px; }
