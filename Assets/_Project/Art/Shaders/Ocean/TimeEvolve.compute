// Per frame: advances h0(k) to h(k,t) and builds every spectral operand the
// surface needs, packed two-real-fields-per-complex so four IFFTs become two.
//
//   Spec0 = (Dx + i*Dz , y + i*dDx/dz)   -> after IFFT: (Dx, Dz, y, dxz)
//   Spec1 = (sx + i*sz , dDx/dx + i*dDz/dz) -> after IFFT: (sx, sz, dxx, dzz)
//
// ResolveOutputs then applies the (-1)^(x+y) centering sign, folds choppiness
// lambda into the horizontal terms, and writes the final half-precision RTs
// the shader, the foam kernel and the physics readback all consume.

#pragma kernel TimeEvolve
#pragma kernel ResolveOutputs

Texture2DArray<float4> H0;
Texture2DArray<float4> WaveData;
// Accumulated phase per k, radians, wrapped. Read AND written every frame by
// TimeEvolve; nothing else in the ocean touches it. See the block at the
// sincos below for why the phase is carried rather than recomputed.
RWTexture2DArray<float> Phase;
RWTexture2DArray<float4> Spec0;
RWTexture2DArray<float4> Spec1;

// ResolveOutputs IO
Texture2DArray<float4> Spatial0;
Texture2DArray<float4> Spatial1;
RWTexture2DArray<float4> Displacement;  // (lambda*Dx, y, lambda*Dz, lambda*dxz)
RWTexture2DArray<float4> Derivatives;   // (sx, sz, lambda*dxx, lambda*dzz)

cbuffer Params
{
    // Per-cascade choppiness. It used to be one scalar for the whole
    // simulation, which made crest SHARPNESS and sampler COST the same knob:
    // lambda is the horizontal displacement the CPU twin inverts by Newton, so
    // every raise costs an iteration, and the budget is spent (see
    // SampleJobs.NewtonIterations). Split per cascade it stops being one knob.
    // The readback only carries cascades 0 and 1 (DisplacementReadback.
    // PhysicsCascades = 2), so cascade 2 -- the 32 m patch, the near-field chop
    // the eye actually reads as "sharp" -- is invisible to the sampler and can
    // be sharpened for nothing. x and y are NOT free and must not be moved
    // without re-running DivergenceProbe.
    float4 _LambdaC;   // xyz = per-cascade lambda, w unused
    uint _N;
    // Named _OceanTime, not _Time: the latter is a Unity built-in shader
    // global and colliding with it silently feeds the wrong clock in.
    float _OceanTime;
    // Ocean seconds since the previous TimeEvolve dispatch -- the phase
    // integrator's step. Zero when the clock is paused, so a pinned sea stays
    // pinned without a special case.
    float _PhaseDt;
    // 1 = ignore the stored phase and set it to omega * _OceanTime. Used for
    // the first dispatch after the textures are created, whenever OceanTime is
    // scrubbed (which is how probes pin the sea), and every frame while phase
    // accumulation is switched off for an A/B.
    uint _SeedPhase;
}

static const float TWO_PI = 6.28318530718f;
static const float INV_TWO_PI = 0.15915494309f;

float2 CMul(float2 a, float2 b)
{
    return float2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

[numthreads(8, 8, 1)]
void TimeEvolve(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _N || id.y >= _N) return;

    float4 h0 = H0[id];
    float4 wd = WaveData[id];
    float2 k = wd.xy;
    float klen = wd.w;

    if (klen < 1e-6f)
    {
        Spec0[id] = 0;
        Spec1[id] = 0;
        return;
    }

    // PHASE IS CARRIED, NOT RECOMPUTED.
    //
    // This used to be sincos(wd.z * _OceanTime), i.e. phase = omega(k) * t off
    // the absolute clock. That is only correct while omega is constant, and it
    // is not: omega = sqrt(g k tanh(k * depth)) and `depth` is lerped across
    // the sea state blend -- 200 m through Calm and Normal, then 50 m at Rough
    // and 30 m at Stormy. So every spectrum rebuild (4 Hz while the weather
    // moves, which in a running sea is always, because sets and lulls swing Hs
    // +/-16 %) recomputed WaveData with a slightly different omega, and the
    // whole surface jumped by d_omega * t.
    //
    // That product is the bug. d_omega per rebuild is tiny, but it multiplies
    // the ABSOLUTE session clock, so the jump grows without bound the longer
    // the game runs, four times a second:
    //
    //     lambda 512 m, a steady Rough sea, depth wobbling 45 <-> 55 m
    //     t =   60 s -> 0.006 rad jump   (0.1x the wave's real motion)
    //     t = 1000 s -> 0.106 rad        (1.7x)
    //     t = 3000 s -> 0.319 rad        (5.0x -- the swell jerks further than
    //                                     it travels, every rebuild)
    //
    // Three things follow, and all three match the report exactly. It only
    // happens in heavy water, because Calm->Normal is 200 m at both ends and
    // omega never moves there. It hits the LONG waves, because tanh saturates
    // and short chop is deep-water at any of these depths. And it gets worse
    // the longer you play.
    //
    // Integrating instead means a new omega changes how fast the wave travels
    // from here, which is what a changing sea should do, and the surface stays
    // continuous through it. Wrapping keeps fp32 exact forever, which the old
    // form also lost after a few hours.
    float phase = _SeedPhase != 0u
        ? wd.z * _OceanTime
        : Phase[id] + wd.z * _PhaseDt;
    phase -= TWO_PI * floor(phase * INV_TWO_PI);
    Phase[id] = phase;

    float s, c;
    sincos(phase, s, c);
    float2 e = float2(c, s);
    // h(k,t) = h0(k) e^{iwt} + conj(h0(-k)) e^{-iwt}
    float2 h = CMul(h0.xy, e) + CMul(h0.zw, float2(e.x, -e.y));
    float2 ih = float2(-h.y, h.x);   // i*h
    float2 nih = float2(h.y, -h.x);  // -i*h

    float kx = k.x, kz = k.y;
    float rx = kx / klen, rz = kz / klen;

    // C0 = Dx_spec + i*Dz_spec, with Dx_spec = -i*rx*h, Dz_spec = -i*rz*h
    // i*Dz_spec = rz*h, so C0 = rx*(-i h) + rz*h
    float2 c0 = rx * nih + rz * h;
    // C1 = y + i*dxz: h * (1 + i*kx*kz/|k|)
    float2 c1 = CMul(h, float2(1.0f, kx * kz / klen));
    // C2 = sx + i*sz = i*kx*h + i*(i*kz*h) = h * (-kz + i*kx)
    float2 c2 = CMul(h, float2(-kz, kx));
    // C3 = dxx + i*dzz = h * (kx^2/|k| + i*kz^2/|k|)
    float2 c3 = CMul(h, float2(kx * kx / klen, kz * kz / klen));

    Spec0[id] = float4(c0, c1);
    Spec1[id] = float4(c2, c3);
}

[numthreads(8, 8, 1)]
void ResolveOutputs(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _N || id.y >= _N) return;

    float sgn = ((id.x + id.y) & 1) ? -1.0f : 1.0f;
    float4 p0 = Spatial0[id] * sgn; // (Dx, Dz, y, dxz)
    float4 p1 = Spatial1[id] * sgn; // (sx, sz, dxx, dzz)

    // Written out rather than indexed: a dynamic index into a constant vector
    // is a scalarising branch on some compilers and this is the hottest kernel
    // in the ocean.
    float lam = id.z == 0 ? _LambdaC.x : (id.z == 1 ? _LambdaC.y : _LambdaC.z);

    Displacement[id] = float4(lam * p0.x, p0.z, lam * p0.y, lam * p0.w);
    Derivatives[id] = float4(p1.x, p1.y, lam * p1.z, lam * p1.w);
}
