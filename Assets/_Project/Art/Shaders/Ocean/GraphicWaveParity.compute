#pragma kernel CSMain
float _Ocean_ShorewardTime;
#include "GraphicWaveDetail.hlsl"
RWStructuredBuffer<float4> Results;
[numthreads(64,1,1)]
void CSMain(uint3 id:SV_DispatchThreadID){uint i=id.x;if(i>=1024)return;float2 p=float2(i%32*3.17-45,(i/32)*2.13-38);float h,f;float2 g;ArtSurface(p,h,g,f);Results[i]=float4(h,g,0);}
