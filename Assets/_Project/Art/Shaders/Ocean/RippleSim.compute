// Ship-following 2D wave-equation ripple sim. R = surface offset, G = contact
// foam. Classic leapfrog: h' = 2h - h_prev + c^2 dt^2 laplacian(h), damped,
// with rim damping so waves die before they hit the buffer edge instead of
// reflecting. Impulses (hull footprint, splashes, monster thrash) arrive as a
// small buffer of gaussian stamps. Scroll shifts content when the follow
// anchor snaps to a new texel.

#pragma kernel Step
#pragma kernel Inject
#pragma kernel Scroll
#pragma kernel Clear

RWTexture2D<float2> Curr;
RWTexture2D<float2> InjectPrev;   // same texel one step back, for Inject
Texture2D<float2> PrevTex;
Texture2D<float2> Src;
RWTexture2D<float2> Dst;

struct Impulse { float2 uv; float radius; float height; float foam; };
StructuredBuffer<Impulse> Impulses;

cbuffer Params
{
    uint _N;
    float _C2Dt2;      // (c * dt / texel)^2, clamped for stability
    float _Damping;    // per-step amplitude keep (e.g. 0.995)
    float _FoamDecay;  // per-step foam keep
    uint _ImpulseCount;
    int2 _ScrollOffset;
    // Texel-space origin of Inject's dispatch rect (the C# side dispatches
    // only the union bounding box of this frame's impulses, not the whole
    // field). Defaults to (0,0), which reproduces the old whole-field
    // behaviour if ever left unset.
    int2 _InjectOrigin;
}

// Reads Src (current field) and PrevTex, writes Dst only — the C# side
// rotates the three buffers afterwards. Never update Curr in place here: a
// neighbour read racing another thread's write breaks the leapfrog scheme
// and the field explodes into metre-tall spikes.
[numthreads(8, 8, 1)]
void Step(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _N || id.y >= _N) return;
    uint xm = id.x == 0 ? 0 : id.x - 1;
    uint xp = min(id.x + 1, _N - 1);
    uint ym = id.y == 0 ? 0 : id.y - 1;
    uint yp = min(id.y + 1, _N - 1);

    float h = Src[id.xy].x;
    float lap = Src[uint2(xm, id.y)].x + Src[uint2(xp, id.y)].x
              + Src[uint2(id.x, ym)].x + Src[uint2(id.x, yp)].x - 4.0 * h;
    float hPrev = PrevTex[id.xy].x;

    // Rim damping: fade hard over the outer 12% so the border never reflects.
    float2 centred = (float2(id.xy) + 0.5) / _N - 0.5;
    float rim = smoothstep(0.5, 0.38, max(abs(centred.x), abs(centred.y)));

    float hNew = (2.0 * h - hPrev + _C2Dt2 * lap) * _Damping * rim;
    // Backstop: a ripple is decimetres; nothing legitimate reaches this, and
    // a non-finite texel would otherwise spike the surface mesh forever.
    hNew = clamp(hNew, -1.2, 1.2);
    if (!isfinite(hNew)) hNew = 0.0;
    float foam = Src[id.xy].y * _FoamDecay * rim;

    Dst[id.xy] = float2(hNew, foam);
}

// Impulses are injected as a DISPLACEMENT: the same delta goes into the
// current level AND the previous one, so the leapfrog sees a shape with zero
// initial velocity. Writing only Curr (what this did before) hands the scheme
// a velocity kick instead, and against a CFL number already near the 2D limit
// that rings up into single-texel needles — measured 0.392 m of step between
// neighbouring texels, with offsets reaching 1.71 m against the 2 m clamp.
// One thread per TEXEL, looping the impulses — not one thread per impulse
// looping its neighbourhood. The old shape had every impulse thread do a
// read-modify-write over its own footprint, so two overlapping impulses raced
// and one texel could silently lose a whole impulse its neighbour received.
// That is a single-texel cliff, and it is what survived the amplitude fixes:
// 0.456 m of step between neighbours in a field peaking at 0.77 m. Per-texel
// accumulation also sums overlapping impulses correctly instead of racing.
[numthreads(8, 8, 1)]
void Inject(uint3 id : SV_DispatchThreadID)
{
    // The C# side dispatches only the union bounding box of this frame's
    // impulses; _InjectOrigin is that box's texel-space corner, so the
    // thread's actual field texel is the origin plus its group-local id.
    uint2 texel = uint2(_InjectOrigin) + id.xy;
    if (texel.x >= _N || texel.y >= _N) return;

    float addH = 0.0;
    float addF = 0.0;
    for (uint i = 0; i < _ImpulseCount; i++)
    {
        Impulse imp = Impulses[i];
        float2 c = imp.uv * float(_N);
        float r = max(1.0, imp.radius * float(_N));
        float dist = length(float2(texel) - c);
        if (dist > r) continue;
        float fall = saturate(1.0 - dist / r);
        fall = fall * fall * (3.0 - 2.0 * fall);
        addH += imp.height * fall;
        addF += imp.foam * fall;
    }
    if (addH == 0.0 && addF == 0.0) return;

    float2 v = Curr[texel];
    float2 w = InjectPrev[texel];
    Curr[texel] = float2(clamp(v.x + addH, -1.2, 1.2), saturate(v.y + addF));
    InjectPrev[texel] = float2(clamp(w.x + addH, -1.2, 1.2), w.y);
}

[numthreads(8, 8, 1)]
void Scroll(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _N || id.y >= _N) return;
    int2 src = int2(id.xy) + _ScrollOffset;
    bool inside = src.x >= 0 && src.y >= 0 && src.x < (int)_N && src.y < (int)_N;
    Dst[id.xy] = inside ? Src[src] : float2(0, 0);
}

[numthreads(8, 8, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _N || id.y >= _N) return;
    Dst[id.xy] = float2(0, 0);
}
