/* Gather party sheet (2026-09-27). Portrait, one thumb: a bottom sheet with
   big chips. Built by UI/Sheets/GatherPartySheet.cs. */

.gp-root {
    flex-grow: 1;
    justify-content: flex-end;
}

.gp-scrim {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
}

.gp-sheet {
    background-color: rgb(22, 43, 57);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    padding: 14px 12px 16px 12px;
    max-width: 560px;
    width: 100%;
    align-self: center;
}

.gp-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 232, 214);
    margin-bottom: 6px;
}

.gp-heading {
    font-size: 13px;
    color: rgb(170, 190, 200);
    margin-top: 8px;
    margin-bottom: 2px;
}

.gp-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.gp-btn {
    min-height: 56px;
    min-width: 64px;
    font-size: 17px;
    margin: 3px;
    padding: 4px 10px;
    border-radius: 10px;
    border-width: 0;
    color: rgb(240, 232, 214);
    background-color: rgb(46, 74, 92);
    -unity-text-align: middle-center;
    white-space: normal;
}

.gp-chip {
    flex-grow: 1;
}

.gp-on {
    background-color: rgb(206, 150, 58);
    color: rgb(24, 20, 14);
}

.gp-primary {
    flex-grow: 2;
    background-color: rgb(206, 150, 58);
    color: rgb(24, 20, 14);
    -unity-font-style: bold;
}

.gp-secondary {
    flex-grow: 1;
}

.gp-note {
    font-size: 14px;
    color: rgb(200, 210, 214);
    margin-top: 8px;
    white-space: normal;
}
