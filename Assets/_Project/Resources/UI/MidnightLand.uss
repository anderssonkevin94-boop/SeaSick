.midnight-land .sheet-card, .land-resources, .land-nav {
    background-color: rgb(22, 42, 56);
    border-color: rgb(164, 210, 232);
    border-width: 1px;
    border-radius: 6px;
}
.midnight-land .sheet-inner { border-color: rgba(164, 210, 232, 0.35); }
.midnight-land .sheet-title, .midnight-land .sheet-text,
.midnight-land .sheet-note-text,
.midnight-land .sheet-store-big, .midnight-land .sheet-chip-value,
.midnight-land .sheet-tab-now, .midnight-land .sheet-tab-arrow { color: rgb(232, 242, 246); }
.midnight-land .sheet-eyebrow, .midnight-land .sheet-muted,
.midnight-land .sheet-store-small, .midnight-land .sheet-tab { color: rgb(166, 186, 198); letter-spacing: 0; }
.midnight-land .sheet-tab--on { color: rgb(164, 210, 232); background-color: rgba(164, 210, 232, 0.08); }
.midnight-land .sheet-btn, .midnight-land .sheet-close {
    color: rgb(232, 242, 246); border-color: rgba(164, 210, 232, 0.65);
    background-color: rgb(32, 57, 72);
}
/* 2026-09-26: was a bare 44x44 square (border-width 0, border-radius 0) --
   read as a clipped-off corner next to a rounded Sort pill. Sized to Sort's
   own 40px height and given the same rounding so the header reads as one
   row of controls rather than a button and a leftover square. */
.midnight-land .sheet-close { width: 40px; height: 40px; border-width: 1.5px; border-radius: 10px; }
.midnight-land .sheet-btn--primary { background-color: rgb(164, 210, 232); color: rgb(22, 42, 56); }
.midnight-land .sheet-btn:hover { background-color: rgb(58, 89, 107); }
.midnight-land .sheet-btn--primary:hover { background-color: rgb(194, 228, 242); }
.midnight-land .sheet-btn:disabled { opacity: 0.45; }
.midnight-land .sheet-rule { background-color: rgba(164, 210, 232, 0.4); }
.midnight-land .sheet-tabs, .midnight-land .sheet-actions { border-color: rgba(164, 210, 232, 0.4); }
.midnight-land .sheet-note, .midnight-land .sheet-chip { background-color: rgba(164, 210, 232, 0.06); border-color: rgba(164, 210, 232, 0.3); }
.midnight-land .sheet-bar { background-color: rgb(74, 96, 108); }
.land-nav, .land-resources { position: absolute; flex-direction: row; align-items: center; padding: 4px 10px; }
.land-nav { height: 64px; }
.land-resources { height: 46px; }
.land-icon { width: 28px; height: 28px; flex-shrink: 0; }
.land-resource { flex-direction: row; align-items: center; flex-grow: 1; }
.land-resource > Label, .land-day, .land-nav-button > Label {
    color: rgb(232, 242, 246); font-size: 14px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
    white-space: nowrap; margin-left: 5px;
}
.land-day { font-size: 13px; margin-left: 4px; }
.land-resources .land-icon { width: 22px; height: 22px; }
.land-resource { min-width: 0; flex-shrink: 1; }
.land-resource > Label { font-size: 13px; margin-left: 3px; }
/* A tappable chip (Timber/Boards, 2026-09-27 audit #11) is a Button under
   the hood; strip Unity's default button chrome back down to the plain
   row the icon+number chips have always been, with a faint tap hint. */
.land-resource--tap { background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 0; margin: 0; min-height: 0; border-radius: 6px; }
.land-resource--tap:hover { background-color: rgba(164, 210, 232, 0.12); }
/* The top bar, 2026-09-29: backpack / mood / people / food / day. Every
   chip is a tap and fills the bar's full inner height (46 - 2 border =
   44 px), so the thumb target is the bar, not the text. */
.land-resources { padding: 0 6px; }
.land-resources > .land-resource--tap { align-self: stretch; justify-content: center; min-width: 44px; }
.land-resources .land-resource--icon { flex-grow: 0; width: 48px; }
.land-resources .land-resource--icon .land-icon { width: 26px; height: 26px; }
.land-resources .land-trend { width: 11px; height: 11px; margin-left: 2px; }

/* ---------------- Backpack sheet (2026-09-29) ----------------
   Island store above, ship's hold below; a tile per item with its count
   and a -/+ pair under it. Three tiles to a row on a ~360 px phone card. */
.pack-body { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.pack-scroll { flex-grow: 1; flex-shrink: 1; }
.pack-section-head { flex-direction: row; align-items: center; margin: 6px 0 4px 0; }
.pack-section-title {
    font-size: 15px; color: rgb(232, 242, 246); flex-grow: 1; margin: 0; padding: 0;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.pack-section-meta { font-size: 13px; color: rgb(166, 186, 198); margin: 0; padding: 0; }
.pack-away { font-size: 13px; color: rgb(246, 146, 128); white-space: normal; margin: 2px 0 4px 0; }
.pack-empty { font-size: 13px; color: rgb(166, 186, 198); margin: 2px 0 6px 0; }
.pack-grid { flex-direction: row; flex-wrap: wrap; }
.pack-tile {
    width: 32%; margin: 0 2% 6px 0; padding: 5px 4px 4px 4px; flex-direction: column; align-items: stretch;
    background-color: rgb(26, 48, 64); border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 9px;
}
.pack-grid > .pack-tile--end { margin-right: 0; }
.pack-grid > .pack-tile--dim { background-color: rgb(16, 28, 38); border-color: rgb(28, 46, 59); }
.pack-tile--dim .pack-tile-icon { opacity: 0.35; }
.pack-tile--dim .pack-tile-count { color: rgb(92, 114, 130); }
.pack-tile-top { flex-direction: row; align-items: center; justify-content: center; height: 34px; }
.pack-tile-icon { width: 30px; height: 30px; flex-shrink: 0; }
.pack-tile-count {
    font-size: 15px; color: rgb(232, 242, 246); margin: 0 0 0 4px; padding: 0; white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.pack-tile-name {
    font-size: 12px; color: rgb(166, 186, 198); -unity-text-align: middle-center; margin: 0; padding: 0;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pack-tile-pending { font-size: 12px; color: rgb(164, 210, 232); -unity-text-align: middle-center; margin: 0; padding: 0; height: 16px; }
.pack-tile-btns { flex-direction: row; margin-top: 3px; }
.pack-tile .pack-btn {
    flex-grow: 1; flex-basis: 0; height: 44px; min-width: 0; margin: 0; padding: 0;
    font-size: 22px; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.pack-tile .pack-btn--minus { margin-right: 4px; }
.land-building-status {
    position: absolute; width: 110px; height: 24px;
    background-color: rgb(22,42,56); color: rgb(255,171,142);
    border-color: rgb(164,210,232); border-width: 1px; border-radius: 4px;
    -unity-text-align: middle-center; font-size: 13px; white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.land-nav-button {
    height: 54px; flex-grow: 1; flex-basis: 0; flex-shrink: 1; align-items: center;
    justify-content: center; background-color: rgba(0,0,0,0); border-width: 0;
    border-bottom-width: 3px; border-bottom-color: rgba(0,0,0,0); border-radius: 0; margin: 0 4px; padding: 0;
}
.land-nav-button > Label { margin: 0; font-size: 13px; }
.land-nav-button:hover { background-color: rgba(164,210,232,0.08); }
.land-nav-selected { border-bottom-color: rgb(164,210,232); background-color: rgba(164,210,232,0.08); }
.land-nav-selected > Label { color: rgb(164,210,232); }
.land-flow { flex-direction: row; height: 86px; flex-shrink: 0; align-items: center; }
.land-flow-cell { flex-grow: 1; flex-basis: 0; align-items: center; }
.land-flow-cell .land-icon { width: 32px; height: 32px; margin-bottom: 3px; }
.land-flow-cell > Label { -unity-text-align: middle-center; margin: 0; }
.land-flow-arrow { width: 22px; height: 22px; }
.land-flow-progress { height: 7px; width: 90%; margin-top: 5px; background-color: rgb(74,96,108); border-radius: 3px; }
.land-flow-progress-fill { height: 7px; background-color: rgb(127,200,173); border-radius: 3px; }
.land-production { flex-shrink: 0; }
.land-production-status { height: 40px; margin: 0; white-space: normal; overflow: hidden; }
.land-production .land-flow { height: 86px; }
.land-production .land-flow-cell .land-icon { width: 25px; height: 25px; }
.land-product-choice, .land-amount-choice { height: 44px; min-height: 44px; margin: 0; flex-shrink: 0; }
.land-product-choice { margin-top: 3px; }
.land-product-choice .unity-base-field__input, .land-amount-choice .unity-base-field__input {
    background-color: rgb(32,57,72); border-color: rgb(115,151,173); border-width: 1px; border-radius: 4px;
    padding-left: 10px; padding-right: 10px; min-height: 42px;
}
.land-product-choice .unity-base-popup-field__text, .land-amount-choice .unity-base-popup-field__text {
    color: rgb(232,242,246); font-size: 13px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.land-production-detail { height: 26px; margin: 2px 0 0 0; white-space: normal; }
.land-production-actions { flex-wrap: nowrap; }
.land-amount-choice { width: 112px; margin-right: 6px; }
.land-production-start { height: 44px; min-width: 0; flex-grow: 1; flex-shrink: 1; font-size: 13px; }
.land-production-stop { height: 44px; width: 58px; min-width: 58px; flex-shrink: 0; margin-left: 6px; font-size: 13px; }
.midnight-land .unity-base-dropdown__item { min-height: 44px; }
.midnight-land .unity-base-dropdown__container-inner { background-color: rgb(32,57,72); }
.midnight-land .unity-base-dropdown__label { color: rgb(232,242,246); font-size: 14px; }

/* ---------------- segmented control, dark (2026-09-26) ----------------
   Unstyled under midnight-land before this, so the rations/priority pills
   in FireSheet's Orders page were drawing the light-theme brass -- fixed
   here as a side effect, not a second override. */
.midnight-land .sheet-seg { background-color: rgb(14, 26, 36); border-radius: 9px; }
.midnight-land .sheet-seg-btn { color: rgb(201, 216, 224); }
.midnight-land .sheet-seg-btn--on { background-color: rgb(164, 210, 232); color: rgb(11, 23, 32); }

/* ---------------- Stores bank (2026-09-26) ---------------- */

.stores-title {
    font-size: 20px; color: rgb(232, 242, 246);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.stores-subtitle { font-size: 13px; color: rgb(166, 186, 198); margin-top: 1px; }
.stores-sort-btn { height: 40px; min-width: 0; padding: 0 12px; font-size: 13px; margin: 0; flex-shrink: 0; flex-grow: 0; }

.stores-tabs { flex-direction: row; justify-content: space-between; margin-top: 6px; }
.stores-tab {
    width: 44px; height: 52px; padding: 4px 2px; flex-direction: column;
    align-items: center; justify-content: center; border-radius: 9px;
    background-color: rgb(26, 48, 64); border-width: 1.5px; border-color: rgb(44, 74, 94);
    margin: 0; flex-shrink: 0;
}
.stores-tab--on { background-color: rgb(164, 210, 232); border-color: rgb(164, 210, 232); }
.stores-tab-icon { width: 26px; height: 26px; min-width: 26px; min-height: 26px; flex-shrink: 0; }
.stores-tab-label {
    font-size: 13px; margin-top: 3px; padding: 0; flex-shrink: 0; color: rgb(201, 216, 224);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.stores-tab-all-glyph {
    height: 26px; -unity-text-align: middle-center; font-size: 15px; color: rgb(201, 216, 224);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.stores-tab--on .stores-tab-label, .stores-tab--on .stores-tab-all-glyph { color: rgb(11, 23, 32); }

.stores-grid-wrap { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.stores-grid { flex-direction: column; flex-shrink: 1; }
.stores-grid-row { flex-direction: row; margin-bottom: 6px; }
.stores-tile {
    flex-grow: 1; flex-basis: 0; margin: 0 6px 0 0; padding: 0;
    align-items: center; justify-content: center; position: relative;
    background-color: rgb(26, 48, 64); border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 9px;
}
.stores-grid-row > .stores-tile:last-child { margin-right: 0; }
.stores-tile--dim { background-color: rgb(16, 28, 38); border-color: rgb(28, 46, 59); }
.stores-tile--on { border-width: 2px; border-color: rgb(164, 210, 232); }
.stores-tile-icon { width: 58%; height: 58%; opacity: 1; }
.stores-tile-icon--dim { opacity: 0.3; }
.stores-qty {
    position: absolute; right: 5px; bottom: 2px; font-size: 15px; color: rgb(232, 242, 246);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.stores-qty--dim { color: rgb(92, 114, 130); }
.stores-qty--low { color: rgb(246, 146, 128); }

.stores-detail {
    flex-direction: row; margin-top: 8px; padding: 10px;
    background-color: rgb(26, 48, 64); border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 10px;
    flex-shrink: 0;
}
.stores-detail-icon-wrap {
    width: 56px; height: 56px; flex-shrink: 0; align-items: center; justify-content: center;
    background-color: rgb(14, 26, 36); border-radius: 8px; margin-right: 10px;
}
.stores-detail-icon { width: 44px; height: 44px; }
.stores-detail-col { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.stores-detail-name-row { flex-direction: row; align-items: baseline; flex-wrap: wrap; }
.stores-detail-name {
    font-size: 15px; color: rgb(232, 242, 246); margin-right: 6px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.stores-detail-kind { font-size: 13px; color: rgb(166, 186, 198); }
.stores-detail-blurb { font-size: 13px; color: rgb(201, 216, 224); white-space: normal; margin-top: 2px; }
.stores-detail-split {
    font-size: 13px; color: rgb(164, 210, 232); margin-top: 3px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}

/* Villager activity: fixed panel pixels, never scaled by camera zoom. */
.camp-hand-status {
    position: absolute; width: 90px; height: 22px; margin: 0; padding: 0 3px;
    background-color: rgba(11, 23, 32, 0.86); color: rgb(232, 242, 246);
    border-radius: 4px; font-size: 12px; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.camp-status-footer {
    position: absolute; background-color: rgba(11, 23, 32, 0.94);
    border-radius: 8px; padding: 6px 8px;
}
.camp-tally { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.camp-tally-count { font-size: 12px; color: rgb(232, 242, 246); margin: 2px 6px; padding: 0; }
.camp-food-draft { flex-direction: row; align-items: center; margin-bottom: 4px; }
.camp-food-notice {
    flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal;
    font-size: 13px; color: rgb(232, 242, 246); margin-right: 8px;
}
.camp-food-undo {
    min-height: 44px; min-width: 94px; flex-shrink: 0; margin: 0; padding: 4px 8px;
    background-color: rgb(164, 210, 232); color: rgb(11, 23, 32);
    border-width: 0; border-radius: 6px; font-size: 13px;
}
.camp-status-muted { color: rgb(156, 163, 172); }
.camp-status-danger { color: rgb(255, 133, 125); }
.land-building-status { margin: 0; padding: 0 3px; }
.land-building-status:disabled { opacity: 0.8; }

/* ---------------- thumb bar (island UI restructure 1A, 2026-09-30) ----------------
   Bottom actions: Camp · Build · Ship, or Cancel · Turn · confirm while placing.
   Sizes are in the land panel's units (430x932 reference, ~pt on the phone);
   ThumbBar.cs sets left/width/bottom/height. */
.thumb-bar {
    position: absolute; flex-direction: row; align-items: stretch;
    height: 74px; margin: 0; padding: 0;
}
.thumb-btn {
    flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 44px;
    margin: 0 4px; padding: 6px 4px;
    flex-direction: column; align-items: center; justify-content: center;
    background-color: rgba(11, 23, 32, 0.92);
    border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 18px;
}
.thumb-btn:hover { background-color: rgba(22, 42, 56, 0.94); border-color: rgb(44, 74, 94); }
.thumb-btn:active { background-color: rgba(32, 57, 72, 0.96); }
.thumb-btn--on, .thumb-btn--on:hover { border-color: rgb(164, 210, 232); background-color: rgba(32, 57, 72, 0.96); }
.thumb-btn--primary { flex-grow: 1.4; background-color: rgb(164, 210, 232); border-color: rgb(164, 210, 232); }
.thumb-btn--primary:hover { background-color: rgb(180, 220, 238); border-color: rgb(180, 220, 238); }
.thumb-btn--primary:active { background-color: rgb(132, 184, 210); }
.thumb-btn:disabled { opacity: 0.4; }
.thumb-glyph { width: 28px; height: 28px; flex-shrink: 0; }
.thumb-label {
    margin: 4px 0 0 0; padding: 0; font-size: 15px; color: rgb(232, 242, 246);
    -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.thumb-btn--primary .thumb-label { color: rgb(11, 23, 32); }

/* The placement instruction card, top of the screen under the status bar. */
.thumb-card {
    position: absolute; flex-direction: column; padding: 12px 16px;
    background-color: rgba(11, 23, 32, 0.92);
    border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 18px;
}
.thumb-card-title {
    margin: 0; padding: 0; font-size: 18px; color: rgb(232, 242, 246); white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.thumb-card-hint {
    margin: 3px 0 0 0; padding: 0; font-size: 14px; color: rgb(166, 186, 198); white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.thumb-card-status {
    margin: 5px 0 0 0; padding: 0; font-size: 14px; white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.thumb-card-status--ok { color: rgb(156, 210, 122); }
.thumb-card-status--bad { color: rgb(246, 146, 128); }

/* ---------------- the Next card (island UI restructure 2, 2026-09-30) ----------------
   Directly above the thumb bar, same lane; the whole card is one button.
   NextCard.cs sets left/width/bottom; the height is its content's. */
.next-card {
    position: absolute; flex-direction: row; align-items: center;
    margin: 0; padding: 12px 12px 12px 16px; min-height: 76px;
    background-color: rgb(22, 41, 58);
    border-width: 1.5px; border-color: rgb(164, 210, 232); border-radius: 18px;
}
.next-card:hover { background-color: rgb(28, 50, 70); border-color: rgb(164, 210, 232); }
.next-card:active { background-color: rgb(32, 57, 72); }
.next-card--raid, .next-card--raid:hover { border-color: rgb(228, 98, 58); }
.next-body { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: column; margin: 0 12px 0 0; }
.next-label {
    -unity-text-align: upper-left;
    margin: 0; padding: 0; font-size: 12px; letter-spacing: 1.2px; color: rgb(164, 210, 232); white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.next-card--alert .next-label { color: rgb(242, 196, 109); }
.next-card--raid .next-label { color: rgb(246, 146, 128); }
.next-title {
    -unity-text-align: upper-left;
    margin: 2px 0 0 0; padding: 0; font-size: 20px; color: rgb(232, 242, 246); white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.next-reason {
    -unity-text-align: upper-left;
    margin: 3px 0 0 0; padding: 0; font-size: 14px; color: rgb(166, 186, 198); white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.next-parts { flex-direction: row; flex-wrap: wrap; margin: 5px 0 0 0; }
.next-part { flex-direction: row; align-items: center; margin: 0 6px 0 0; }
.next-part-text {
    margin: 0; padding: 0; font-size: 14px; white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.next-check { width: 16px; height: 16px; margin: 0 0 0 2px; flex-shrink: 0; }
.next-go {
    width: 52px; height: 52px; flex-shrink: 0; border-radius: 14px;
    background-color: rgb(164, 210, 232); align-items: center; justify-content: center;
}
.next-chevron { width: 28px; height: 28px; }

/* The ledger drawer as a bottom sheet above the bar (LedgerDrawer.cs sets
   left/width/bottom/height). Two classes deep so it beats Ledger.uss's
   left-drawer rules, which load after this sheet. */
.ledger-layer.thumb-ledger-bottom > .ledger-drawer {
    top: auto; right: auto;
    border-right-width: 1.5px; border-left-width: 1.5px; border-top-width: 1.5px; border-bottom-width: 1.5px;
    border-color: rgb(44, 74, 94); border-radius: 18px;
    translate: 0 150%;
}
.ledger-layer--open.thumb-ledger-bottom > .ledger-drawer { translate: 0 0; }

/* ---------------- Backpack, the only cargo screen (2026-09-30, island UI phase 4) ----------------
   A pile at the store's ceiling turns its count ember (the old Stores bank's
   low/full colouring). */
.pack-tile--full .pack-tile-count { color: rgb(246, 146, 128); }

/* ---------------- the carry pill (island UI restructure 6, 2026-09-30) ----------------
   What letting go of the villager in the Hand would do, in the thumb lane just
   above the bar / Next card. CarryPill.cs sets left/width/bottom. Never takes a
   touch (picking mode Ignore in code). Ember for a target that refuses. */
.carry-holder {
    position: absolute; flex-direction: row; justify-content: center; align-items: flex-end;
    margin: 0; padding: 0;
}
.carry-pill {
    flex-direction: row; align-items: center; flex-shrink: 1; min-height: 44px;
    margin: 0; padding: 6px 18px;
    background-color: rgb(22, 41, 58);
    border-width: 1.5px; border-color: rgb(164, 210, 232); border-radius: 22px;
}
.carry-pill--no { border-color: rgb(228, 98, 58); background-color: rgb(42, 26, 26); }
.carry-cross { width: 18px; height: 18px; margin: 0 8px 0 0; flex-shrink: 0; }
.carry-text {
    margin: 0; padding: 0; font-size: 18px; color: rgb(232, 242, 246); white-space: normal;
    flex-shrink: 1; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.carry-pill--no .carry-text { color: rgb(246, 146, 128); }
