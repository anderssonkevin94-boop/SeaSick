.yard {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    color: rgb(231, 241, 246);
    background-color: rgb(22, 43, 57);
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.yard Button {
    min-height: 44px;
    min-width: 44px;
    margin: 3px;
    padding: 6px 12px;
    border-width: 1px;
    border-color: rgb(101, 136, 154);
    border-radius: 5px;
    background-color: rgb(31, 57, 72);
    color: rgb(231, 241, 246);
    font-size: 16px;
    flex-shrink: 0;
}
.yard Button:hover { background-color: rgb(48, 79, 96); }
.yard Button:focus { border-color: rgb(177, 227, 247); border-width: 2px; }
.yard Button:disabled { opacity: 0.45; }
.yard-header { flex-direction: row; align-items: center; height: 58px; flex-shrink: 0; padding: 0 8px; border-bottom-width: 1px; border-bottom-color: rgb(101, 136, 154); }
.yard-title { flex-grow: 1; -unity-text-align: middle-center; font-size: 25px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Fraunces-Black.ttf"); }
.yard-body { flex-grow: 1; min-height: 0; }
.yard-viewport { flex-grow: 1; min-height: 120px; overflow: hidden; background-color: rgb(71, 100, 113); }
.yard-render { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.yard-badge { position: absolute; left: 12px; top: 12px; background-color: rgb(22, 43, 57); color: rgb(177, 227, 247); padding: 5px 9px; font-size: 12px; border-radius: 3px; }
.yard-views { position: absolute; right: 8px; top: 8px; }
.yard-sections { position: absolute; left: 0; right: 0; bottom: 0; flex-direction: row; padding: 6px; }
.yard-sections Button.yard-section-button { flex-grow: 1; flex-basis: 0; min-height: 48px; margin: 3px;
    background-color: rgba(22, 43, 57, 0.55); border-color: rgba(171, 223, 246, 0.55); }
.yard-sections Button.yard-section-button:hover { background-color: rgba(48, 79, 96, 0.75); }
.yard Button.yard-icon-button { width: 44px; height: 44px; padding: 10px; }
.yard-icon { width: 24px; height: 24px; flex-shrink: 0; }
/* 340 -> 460: the overview's own content (Hull tiles, Beam, Deck rows,
   summary, warnings, footer) does not fit 340px in portrait once
   yard-tiles/yard-wheels report their TRUE content height (see the two
   comments above) -- it was only fitting before because those rows'
   own auto-height was silently under-reporting itself; the ship
   preview above keeps plenty of room to give some back (2026-09-25
   phone screenshot: Confirm refit was drawn over Raise all/the
   summary). Landscape (.yard-wide) overrides this to height: auto. */
.yard-panel { height: 460px; flex-shrink: 0; border-top-width: 1px; border-top-color: rgb(101, 136, 154); }
/* overflow: hidden -- a safety net matching .yard-sheet-body's own (never
   let a page that runs long draw OVER the footer instead of stopping at
   this element's edge); the overview/report split above (ShipyardScreen.cs,
   docs/SHIPYARD-UX-AUDIT.md item 1/3) is what actually keeps each page's
   real content inside the band. */
.yard-options { flex-grow: 1; min-height: 0; padding: 12px 12px 0 12px; overflow: hidden; }
.yard-heading { font-size: 20px; margin-bottom: 8px; }
.yard-length { flex-direction: row; align-items: center; }
.yard-length-title { flex-grow: 1; }
.yard-count { width: 26px; -unity-text-align: middle-center; font-size: 20px; }
/* The Interior page's "{n} berths" label needs far more room than the
   2-digit yard-count it used to share (phone screenshot, 2026-09-25:
   "-4 berths" clipped to "-4 bertl" inside a 26px box). */
.yard-berth-count { flex-grow: 1; -unity-text-align: middle-center; font-size: 20px; min-width: 0; }
.yard-measure { color: rgb(171, 209, 226); margin-top: 2px; margin-bottom: 10px; }
.yard-details { white-space: normal; font-size: 13px; color: rgb(191, 205, 211); margin: 12px 0; flex-shrink: 0; }
.yard-caption { color: rgb(173, 194, 205); font-size: 13px; }
/* min-height: measured live (2026-09-25 phone screenshot) that this row's
   own auto height (22-23px) does not track its Button children's real
   min-height-driven height (44px) -- same understatement as yard-tiles
   above -- so the next caption in flow ("Deck (tap a section tile
   above...)") drew over the Standard/Wide row's true bottom edge. */
.yard-wheels { flex-direction: row; min-height: 50px; }
.yard-wheels Button { flex-grow: 1; flex-basis: 0; }
.yard Button.yard-selected { border-color: rgb(171, 223, 246); background-color: rgb(48, 83, 102); }
/* No max-height: a blocked-Confirm reason used to truncate to "see
   details" past 100 characters with the full text only in the tooltip --
   invisible on a phone with no hover (docs/SHIPYARD-UX-AUDIT.md item 4).
   The full reason now always renders here; letting the box grow is the
   trade Kevin's standard asks for over ever hiding a reason. */
.yard-message { color: rgb(191, 205, 211); font-size: 13px; white-space: normal; margin: 4px 12px 0 12px; min-height: 18px; flex-shrink: 0; }
.yard-options .unity-scroller--vertical { width: 6px; margin-left: 4px; }
.yard-options .unity-scroller__low-button, .yard-options .unity-scroller__high-button { display: none; }
.yard-options .unity-base-slider__tracker { background-color: rgb(31, 57, 72); border-width: 0; }
.yard-options .unity-base-slider__dragger { background-color: rgb(101, 136, 154); border-width: 0; border-radius: 3px; }
.yard-footer { flex-direction: row; padding: 8px; flex-shrink: 0; }
.yard-footer Button { flex-grow: 1; flex-basis: 0; }
.yard-footer Button.yard-confirm { flex-grow: 2; background-color: rgb(171, 218, 239); color: rgb(22, 43, 57); }
.yard-guns { flex-direction: column; }
.yard Button.yard-gun-row { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; -unity-text-align: middle-left; }
.yard-gun-label { -unity-text-align: middle-left; flex-shrink: 0; }
/* min-width: 0 overrides a flex item's default auto min-width (its
   unwrapped content width), which is what let this status text run off
   the right edge of the phone screen instead of wrapping -- the same
   flexbox gotcha `.yard`'s own min-width: 0 at the top of this file
   exists to avoid, just missed here (2026-09-25, phone screenshot). */
.yard-gun-status { -unity-text-align: middle-right; color: rgb(171, 209, 226); font-size: 12px; flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 8px; white-space: normal; }
.yard-dock { margin-bottom: 10px; white-space: normal; }
.yard-wide .yard-body { flex-direction: row; }
/* 330 -> 420: a gun row's "Middle bay 1, starboard gun" label plus its
   status text has to share this panel's width, and at 330px the status
   wrapped to 4-5 lines and pushed the list past yard-sheet-body's
   overflow: hidden, clipping a row entirely (desktop screenshot,
   2026-09-25). */
.yard-wide .yard-panel { width: 420px; height: auto; border-top-width: 0; border-left-width: 1px; border-left-color: rgb(101, 136, 154); }
.yard-wide .yard-viewport { min-width: 200px; }
/* Even at 420px, label + status side by side leaves too little room for
   the status text -- stack them so each gets the row's full width. */
.yard-wide .yard Button.yard-gun-row { flex-direction: column; align-items: flex-start; }
.yard-wide .yard-gun-status { -unity-text-align: middle-left; flex-grow: 0; margin-left: 0; margin-top: 2px; }

/* ---- Overview: section tiles (docs/SHIPYARD-SECTIONS-UI.md Step 1) ---- */
/* flex-wrap: wrap used to let a 5-section hull's 9 tiles (5 tiles + 4 "+"
   inserts) spill onto a second row -- and a flex-wrap row's own auto
   height does not reliably track wrapped children in this UI Toolkit
   version (see the min-height history below), so that second row drew
   straight OVER the Beam/Deck rows underneath instead of pushing them
   down (2026-09-26 phone screenshot, 3 middles). nowrap + flex-shrink on
   the tiles themselves (overridden below -- `.yard Button` sets
   flex-shrink: 0 for every button) keeps everything on ONE row and lets
   ShipyardScreen.cs's `yard-tiles--compact` (4+ sections) shrink type and
   content instead of the row ever needing a second line. */
.yard-tiles { flex-direction: row; flex-wrap: nowrap; padding: 4px 0 8px 0; margin-bottom: 4px; min-height: 84px; }
.yard Button.yard-tile { flex-grow: 1; flex-shrink: 1; flex-basis: 64px; min-height: 80px; flex-direction: column; align-items: center; justify-content: center; padding: 4px; }
.yard-tile-name { font-size: 14px; -unity-text-align: middle-center; }
.yard-tile-deck { font-size: 10px; -unity-text-align: middle-center; color: rgb(171, 209, 226);
    background-color: rgba(171, 209, 226, 0.16); border-radius: 8px; padding: 1px 7px; margin-top: 2px; }
.yard-tile-deck--raised { color: rgb(22, 43, 57); background-color: rgb(171, 218, 239); }
.yard-deck-reason { margin-top: -4px; margin-bottom: 6px; white-space: normal; }
/* min-width: 0 so a long "guns 2 · berths 4 · hold 5" status line can
   actually wrap inside the tile instead of forcing the tile (and this
   flex-wrap row's own height) wider/taller than what yard-tiles
   reserved, which let the wrapped second line bleed into the "Beam"
   caption below it (phone screenshot, 2026-09-25). */
.yard-tile-status { font-size: 10px; color: rgb(171, 209, 226); -unity-text-align: middle-center; white-space: normal; min-width: 0; }
.yard Button.yard-tile-insert { flex-grow: 0; flex-shrink: 1; flex-basis: 32px; min-width: 32px; min-height: 44px; padding: 0; font-size: 18px; opacity: 0.8; }
/* Compact mode (4+ sections, ShipyardScreen.RefreshTiles): smaller type
   and a shorter one-line status (set in code) so the whole row of tiles
   plus "+" inserts still fits ONE line at phone width instead of
   wrapping. Tiles still meet the min-height-44 tap target; only their
   WIDTH and text shrink. */
.yard .yard-tiles--compact.yard-tiles { min-height: 64px; }
.yard .yard-tiles--compact Button.yard-tile { min-height: 60px; flex-basis: 44px; padding: 3px 2px; }
.yard .yard-tiles--compact .yard-tile-name { font-size: 11px; }
.yard .yard-tiles--compact .yard-tile-deck { font-size: 9px; padding: 0 5px; margin-top: 1px; }
.yard .yard-tiles--compact .yard-tile-status { font-size: 9px; }
/* Thin "+" inserts in compact mode -- explicitly called out in the fix
   ("the '+' tiles become thin"): they stay tappable (min-height 44) but
   give their width back to the section tiles, which need it more. */
.yard .yard-tiles--compact Button.yard-tile-insert { flex-basis: 18px; min-width: 18px; font-size: 14px; margin: 3px 1px; }
/* A tooltip alone (":disabled" opacity 0.45, shared by every button in
   the yard) is too subtle to read as "this control is off" at max hull
   length next to otherwise-identical tiles, and is invisible on a phone
   with no hover anyway -- `maxLengthReason` under the row states WHY in
   text, this makes the tile itself unmistakably inert. */
.yard Button.yard-tile-insert:disabled { opacity: 0.28; border-color: rgba(101, 136, 154, 0.4); background-color: rgba(31, 57, 72, 0.5); }
.yard-summary { margin-top: 4px; }
.yard-summary-row { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.yard-summary-item { font-size: 12px; color: rgb(191, 205, 211); margin-right: 10px; }
.yard-warnings { color: rgb(240, 191, 140); font-size: 12px; white-space: normal; margin-top: 4px; }

/* ---- Section sheet ---- */
.yard-sheet { flex-grow: 1; min-height: 0; flex-direction: column; }
.yard-sheet-head { padding: 8px 12px 0 12px; flex-shrink: 0; }
.yard-sheet-title { font-size: 18px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Fraunces-Black.ttf"); }
/* The strip is rebuilt whole every Fill() now (page count can change --
   see ShipyardSectionSheet.RebuildStrip), so its holder needs the same
   pinning every bare/rebuilt element in this file needs (PinnedRule's own
   comment): without flex-shrink:0 a holder with no intrinsic size of its
   own can measure short and the tab row goes missing. */
.yard-sheet-strip { flex-shrink: 0; }
/* overflow: hidden clips a page that runs long (e.g. a middle section
   with several gun slots) so it disappears under this element's own
   bottom edge instead of painting over yard-sheet-footer's Reset
   section/Done buttons below it -- caught on the phone gun-slot
   screenshot, 2026-09-25. GDD still says "no scrolling: pages you swipe
   between", so this clips rather than adding a ScrollView. */
/* padding-top 8 -> 18: the strip's own selected-tab underline sits right
   at its bottom edge, and 8px left the first line of body text (e.g.
   "Deck level needs the wide beam...") drawn touching/under it (phone
   screenshot, 2026-09-25). */
.yard-sheet-body { flex-grow: 1; min-height: 0; padding: 18px 12px 8px 12px; overflow: hidden; }
.yard-sheet-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.yard-sheet-row Button.yard-seg-button { flex-grow: 1; flex-basis: 0; }
.yard-sheet-footer { flex-direction: row; padding: 8px; flex-shrink: 0; }
.yard-sheet-footer Button { flex-grow: 1; flex-basis: 0; }
.yard Button.yard-sheet-done { flex-grow: 2; background-color: rgb(171, 218, 239); color: rgb(22, 43, 57); }
.yard Button.yard-sheet-danger { background-color: rgb(92, 44, 40); border-color: rgb(196, 120, 105); width: 100%; margin-top: 6px; }

/* SheetKit's text/rule/bar helpers are styled for the PAPER sheet theme
   (dark ink on a light card) -- Sheets.uss's `.sheet-text` is rgb(31,45,56),
   nearly the same colour as this sheet's own dark navy background, and
   `.sheet-bar`'s track is a 16% dark tint that disappears the same way.
   The section sheet borrows those helpers (ShipyardSectionSheet.cs) but
   sits on `.yard`'s dark background, so both need light-theme colours here
   rather than in Sheets.uss itself, which other (paper) sheets still use
   as-is (2026-09-25 phone screenshot: "Hold: 5 cells" and the budget bar's
   track were both invisible). */
.yard-sheet .sheet-text { color: rgb(225, 240, 246); }
.yard-sheet .sheet-muted { color: rgba(225, 240, 246, 0.68); }
.yard-sheet .sheet-eyebrow { color: rgba(225, 240, 246, 0.68); }
.yard-sheet .sheet-rule { background-color: rgba(225, 240, 246, 0.22); }
.yard-sheet .sheet-bar { background-color: rgba(225, 240, 246, 0.18); }
/* SheetKit.Note's own colours (Sheets.uss) are tuned for the paper sheet
   theme too, same problem as the block above -- the audit's phone
   screenshot (docs/SHIPYARD-UX-AUDIT.md, "Structure page") found the note
   text near-invisible against this dark background and its leading
   character reading as clipped under the pencil glyph. Lighter text plus
   room for the glyph fixes both: the glyph is absolutely laid out by
   Sheets.uss and was sitting flush against the text with no gap. */
.yard-sheet .sheet-note-text { color: rgb(225, 240, 246); padding-left: 4px; }
.yard-sheet .sheet-note-glyph { color: rgb(225, 240, 246); }

/* ---- blocking vs advisory text (docs/SHIPYARD-UX-AUDIT.md item 4):
   a HARD block (report.blocking -- would refuse Confirm, or a slot that
   cannot be used at all) reads as a warning colour, distinct from
   SheetKit.Note's neutral/advisory (report.warnings) styling above. */
.yard-blocking-text { color: rgb(240, 150, 130); font-size: 12px; white-space: normal; margin-top: 2px; }
.yard Button.yard-gun-row--blocked { border-color: rgba(240, 150, 130, 0.55); background-color: rgba(92, 44, 40, 0.35); }
.yard Button.yard-gun-row--blocked .yard-gun-label { opacity: 0.75; }

/* ---- Interior: the 2D cutaway (v2, 2026-09-26) ----
   SectionCutaway.Layout() places every cell / marker absolutely from one
   measured width and sets the element's own height, so nothing here sizes
   or positions them -- these rules are look only. */
.yard-cutaway { flex-shrink: 0; margin-bottom: 6px; }
.yard Button.yard-cutaway-gun { width: 44px; height: 44px; min-width: 44px; min-height: 44px;
    padding: 0; margin: 0; background-color: transparent; border-width: 0;
    align-items: center; justify-content: center; }
.yard Button.yard-cutaway-gun:hover { background-color: transparent; }
.yard-cutaway-gun-dot { width: 34px; height: 34px; border-radius: 17px; border-width: 2px;
    align-items: center; justify-content: center;
    background-color: rgb(22, 43, 57); border-color: rgb(171, 209, 226); }
.yard-cutaway-gun-dot--fitted { background-color: rgb(171, 218, 239); border-color: rgb(225, 240, 246); }
.yard-cutaway-gun-dot--blocked { border-color: rgba(240, 150, 130, 0.8); }
.yard-cutaway-gun-dot .yard-cutaway-icon { width: 22px; height: 22px; }
.yard-cutaway-gun-side { position: absolute; right: 0; bottom: 1px; width: 15px; height: 15px; border-radius: 8px;
    font-size: 10px; -unity-text-align: middle-center; padding: 0; margin: 0;
    background-color: rgb(22, 43, 57); color: rgb(225, 240, 246); border-width: 1px; border-color: rgb(171, 209, 226); }
.yard-cutaway-lane { font-size: 11px; color: rgba(225, 240, 246, 0.6); padding: 0; margin: 0; }
.yard Button.yard-cutaway-cell { min-width: 44px; min-height: 44px; margin: 0; padding: 0;
    align-items: center; justify-content: center; border-width: 1px; border-radius: 4px; }
.yard Button.yard-cutaway-cell--cargo { background-color: rgba(201, 147, 57, 0.28); border-color: rgb(214, 170, 96); }
.yard Button.yard-cutaway-cell--cargo:hover { background-color: rgba(201, 147, 57, 0.42); }
.yard Button.yard-cutaway-cell--bunk { background-color: rgba(120, 190, 225, 0.26); border-color: rgb(171, 218, 239); }
.yard Button.yard-cutaway-cell--bunk:hover { background-color: rgba(120, 190, 225, 0.40); }
.yard Button.yard-cutaway-cell--flash { border-width: 3px; border-color: rgb(255, 244, 200); background-color: rgba(255, 236, 170, 0.45); }
.yard-cutaway-cell .yard-cutaway-icon { width: 28px; height: 28px; }
.yard-cutaway-icon { width: 18px; height: 18px; flex-shrink: 0; }
/* Totals row: the same icons as the cells, so it doubles as the legend. */
.yard-cutaway-totals { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; min-height: 26px; margin-bottom: 2px; }
.yard-cutaway-total { flex-direction: row; align-items: center; margin-right: 14px; }
.yard-cutaway-total .yard-cutaway-icon { width: 20px; height: 20px; margin-right: 4px; }
.yard-cutaway-total-text { font-size: 14px; color: rgb(225, 240, 246); -unity-font-style: bold; padding: 0; margin: 0; }
.yard-cutaway-swatch { width: 12px; height: 12px; border-radius: 3px; border-width: 1px; margin-right: 4px; }
.yard-cutaway-delta { font-size: 12px; color: rgba(225, 240, 246, 0.72); white-space: normal; flex-shrink: 0; }
.yard-cutaway-delta--changed { color: rgb(255, 232, 170); }
.yard-dock-line { margin-top: 4px; }
