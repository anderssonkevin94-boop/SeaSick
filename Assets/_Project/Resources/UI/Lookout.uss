/* ------------------------------------------------------------------
 * The Lookout and Raid cards (menu rework #1 / #2, 2026-09-27):
 * header glyph tile, the "why" chips, the quiver / threat card, a
 * 3-wide villager tile grid (tap = post / relieve) and the thumb row.
 * Rides on Station.uss (`.st`) and Hand.uss (`.hs-*` chips, tiles,
 * toast), which `LookoutSheet` / `RaidSheet` load first; everything
 * here is `.lk-*` under `.st` so it reaches nothing else.
 * PANEL UNITS, same scale notes as Station.uss.
 * ------------------------------------------------------------------ */

/* --- header glyph tile ------------------------------------------------ */

.lk-glyph-box {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background-color: rgb(19, 34, 46);
    border-width: 2px;
    border-color: rgb(44, 74, 94);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}
.lk-glyph { width: 34px; height: 34px; }

/* --- the quiver / threat card ----------------------------------------- */

.st .lk-card--warn { border-color: rgb(240, 195, 106); }
.st .lk-card--bad { border-color: rgb(246, 146, 128); background-color: rgb(42, 26, 26); }
.st .lk-card--good { border-color: rgb(31, 74, 60); }
.st .lk-card .hs-now-s { white-space: normal; }

/* the "nobody can be posted" note that stands in for the tiles */
.st .lk-note { margin-top: 2px; }
.st .lk-note-t { font-size: 16px; color: rgb(201, 216, 224); white-space: normal; }

/* --- villager tiles ---------------------------------------------------- */

.lk-av {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgb(44, 74, 94);
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    flex-shrink: 0;
}
.st .lk-av-t { font-size: 19px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st .lk-tile--idle { border-color: rgb(159, 224, 194); }
.st .lk-tile--idle .hs-tile-s { color: rgb(159, 224, 194); }
.st .hs-tile--on .lk-av { background-color: rgb(164, 210, 232); }
.st .hs-tile--on .lk-av-t { color: rgb(11, 23, 32); }

.lk-pill {
    position: absolute;
    top: 5px;
    right: 5px;
    height: 22px;
    padding: 0 8px;
    border-radius: 11px;
    background-color: rgb(74, 35, 32);
    align-items: center;
    justify-content: center;
}
.st .lk-pill-t { font-size: 12px; color: rgb(246, 146, 128); -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }

/* --- the thumb row ------------------------------------------------------ */

.st .lk-act--pri { background-color: rgb(164, 210, 232); border-color: rgb(164, 210, 232); color: rgb(11, 23, 32); }
.st .lk-act--pri:hover { background-color: rgb(190, 226, 242); }

/* ------------------------------------------------------------------
 * CardKit (2026-09-27, menu rework #7 / #10 / campfire): the small
 * Midnight cards -- Manifest, Campfire, Wall, Ladder, Road, Chart --
 * built on `.st` + Hand.uss tiles. Everything here is `.ck-*`.
 * ------------------------------------------------------------------ */

.ck-col { flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: hidden; }
/* Pills wrap onto further rows; a long pill takes its own row and its words
 * wrap inside it (2026-10-02 rule: UI text is never cut with an ellipsis). */
.ck-pills { flex-direction: row; flex-wrap: wrap; margin-top: 8px; flex-shrink: 0; }
.st .ck-pill {
    min-height: 44px;
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    padding: 5px 14px;
    margin: 0 8px 8px 0;
    border-radius: 22px;
    background-color: rgb(19, 34, 46);
    border-width: 2px;
    border-color: rgb(44, 74, 94);
    color: rgb(232, 242, 246);
    font-size: 14px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .ck-pill:disabled { opacity: 0.6; }
/* A pill that carries a sentence (a blocker, a two-tap question): its own
 * full-width row, words left-aligned like the notes (ShipSheet). */
.st .ck-pill--line { width: 100%; margin-right: 0; border-radius: 16px; -unity-text-align: middle-left; }
.st .ck-pill--ice { border-color: rgb(164, 210, 232); color: rgb(164, 210, 232); }
.st .ck-pill--wait { border-color: rgb(240, 195, 106); color: rgb(240, 195, 106); }
.st .ck-pill--good { border-color: rgb(159, 224, 194); color: rgb(159, 224, 194); }
.st .ck-pill--bad { border-color: rgb(246, 146, 128); color: rgb(246, 146, 128); }

.ck-av {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(44, 74, 94);
    align-items: center;
    justify-content: center;
    margin-right: 6px;
    flex-shrink: 0;
}
.st .ck-av-t { font-size: 14px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st .hs-tile--on .ck-av { background-color: rgb(164, 210, 232); }
.st .hs-tile--on .ck-av-t { color: rgb(11, 23, 32); }
.st .ck-tile--wide { width: 100%; margin-right: 0; }
.st .ck-tile--short .hs-tile-s { color: rgb(246, 146, 128); }
.st .ck-tile--ok .hs-tile-s { color: rgb(159, 224, 194); }

.ck-card { margin-top: 10px; flex-shrink: 0; }
.ck-bar { margin-top: 8px; margin-bottom: 0; }
.st .ck-note { font-size: 14px; color: rgb(166, 186, 198); white-space: normal; margin-top: 6px; }
.ck-map {
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(44, 74, 94);
    background-color: rgb(18, 48, 73);
    margin-top: 8px;
    flex-shrink: 0;
}
.ck-seg { margin-top: 8px; flex-shrink: 0; }

/* --- the "Welcome back" report (2026-09-30, Melvor-style) --------------- */
/* One card per camp; item rows are icon · name · +N; events are tinted
 * bars, the worst first. Numbers are 20 px on the phone. */

.aw-col { flex-direction: column; flex-grow: 1; padding-bottom: 8px; }
.aw-top { flex-direction: row; align-items: center; min-height: 48px; flex-shrink: 0; }
.st .aw-eye { margin-top: 12px; margin-bottom: 4px; }

.aw-row { flex-direction: row; align-items: center; min-height: 40px; flex-shrink: 0; }
.aw-ico { width: 34px; height: 34px; margin-right: 10px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.st .aw-name { font-size: 18px; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.st .aw-num { font-size: 21px; margin-left: 10px; flex-shrink: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st .aw-num--good { color: rgb(127, 200, 173); }
.st .aw-num--out { color: rgb(240, 195, 106); }

.aw-ev { flex-direction: row; align-items: center; margin-top: 6px; padding: 8px 12px; border-left-width: 5px; border-radius: 10px; flex-shrink: 0; background-color: rgb(14, 26, 36); }
.aw-ev--bad { border-color: rgb(246, 146, 128); background-color: rgb(42, 26, 26); }
.aw-ev--warn { border-color: rgb(240, 195, 106); background-color: rgb(38, 32, 18); }
.aw-ev--good { border-color: rgb(127, 200, 173); }
.st .aw-ev-t { font-size: 18px; white-space: normal; flex-shrink: 1; }
.st .aw-ev--bad .aw-ev-t, .st .aw-hungry { color: rgb(246, 146, 128); }
.st .aw-ev--warn .aw-ev-t { color: rgb(240, 195, 106); }

/* --- the grave sheet (island UI restructure 6, 2026-09-30) ---------------- */
/* The story's three sentences, and the list of every grave: one 56-unit row
 * each (initial · name / "Day 3–9 · killed in a raid · Home" · ›), newest
 * first. GraveSheet.cs. */

.st .gr-story { font-size: 17px; white-space: normal; margin-bottom: 6px; }
.st .gr-row {
    flex-direction: row; align-items: center; flex-shrink: 0;
    min-height: 56px; margin: 0 0 8px 0; padding: 6px 12px;
    background-color: rgb(19, 34, 46);
    border-width: 2px; border-color: rgb(44, 74, 94); border-radius: 14px;
}
.st .gr-row:hover { background-color: rgb(26, 48, 64); }
.st .gr-row .ck-av { width: 36px; height: 36px; border-radius: 18px; margin-right: 10px; }
.st .gr-row .ck-av-t { font-size: 17px; }
.st .gr-name { font-size: 17px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); white-space: normal; max-width: 100%; }
.st .gr-sub { font-size: 13px; color: rgb(166, 186, 198); white-space: normal; max-width: 100%; }
.st .gr-go { font-size: 26px; color: rgb(110, 132, 148); margin-left: 8px; flex-shrink: 0; }
