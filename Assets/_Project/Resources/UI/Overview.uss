/* Camp › the goal chain (its YOUR GOAL section lives in CampSheet since 2026-09-30;
   written for CampOverviewSheet, 2026-09-27, deleted in island UI phase 4).
   Colours from Kevin's GoalChain / Camp navigation mockups:
   card #13222E, raised #1A3040, border #2C4A5E, ice #A4D2E8,
   pearl #E8F2F6, muted #A6BAC6, green #9FE0C2, amber #F0C36A, red #F69280. */

.ov-head-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ov-title {
    font-size: 20px; color: rgb(232, 242, 246);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-subtitle { font-size: 13px; color: rgb(166, 186, 198); margin-top: 1px; }
.ov-head-btn {
    width: 44px; height: 44px; margin: 0 8px 0 0; padding: 0; flex-shrink: 0;
    font-size: 20px; color: rgb(232, 242, 246);
    background-color: rgb(26, 48, 64); border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 10px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}

/* `SheetHost.FillTab` force-sets every sheet's root to `flex-shrink: 0`
   (deliberately -- "never squeezed", 2026-09-23) so a page that overflows
   the band gets cut at the bottom instead of squashing every block into
   overlapping garbage. That means THIS class's own `flex-shrink` never
   actually reaches Yoga -- an inline style always beats a stylesheet rule --
   so nothing here shrank to the page's real height and the chain's own
   `.ov-block-solo` scrolling had no bounded box to scroll inside: it still
   measured out to its natural (unclipped) size, taller than the page, and
   the tail of it -- the first-step/Go card -- was `page`'s OWN
   `overflow: hidden` quietly eating it, one level higher than anything in
   this file could see. `max-height: 100%` sidesteps flex-shrink entirely:
   it bounds this element against `page`'s resolved height directly, so a
   short chain still hugs its own content (no dead space added) and a long
   one is finally bounded for `.ov-block-solo` to actually shrink against. */
.ov-root { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-height: 0; max-height: 100%; overflow: hidden; }
.ov-seg { margin-bottom: 8px; flex-shrink: 0; }
.ov-seg .sheet-seg-btn { height: 44px; flex-grow: 1; font-size: 14px; }
.ov-block { flex-direction: column; flex-shrink: 0; margin-bottom: 6px; }
/* A block with the whole page to itself (segmented view, one side shown):
   let it fill the page so its OWN scrollable (`.ov-chain`) can be bounded
   and scroll, instead of the block just growing past the page and losing
   whatever comes after the scrollable to `.ov-root`'s `overflow: hidden`. */
.ov-block-solo { flex-grow: 1; flex-shrink: 1; min-height: 0; }

.ov-eyebrow {
    font-size: 12px; color: rgb(164, 210, 232); letter-spacing: 1px; margin: 6px 0 4px 0;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}

/* --- NEXT GOAL --- */
.ov-goal-head { flex-direction: column; }
.ov-goal-head .ov-eyebrow { margin-top: 0; margin-bottom: 0; }
.ov-eyebrow-row { flex-direction: row; align-items: center; justify-content: space-between; }
.ov-clear-goal {
    height: 30px; margin: 0; padding: 0 12px; border-radius: 15px; font-size: 13px;
    background-color: rgb(19, 34, 46); border-width: 1.5px; border-color: rgb(44, 74, 94);
    color: rgb(164, 210, 232);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.ov-clear-goal:hover { background-color: rgb(32, 57, 72); }
.ov-goal-title {
    font-size: 22px; color: rgb(232, 242, 246);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-goal-why { font-size: 13px; color: rgb(166, 186, 198); white-space: normal; }
.ov-bar { height: 10px; margin-top: 8px; background-color: rgb(19, 34, 46); border-radius: 5px; overflow: hidden; }
.ov-bar-fill { height: 10px; background-color: rgb(164, 210, 232); border-radius: 5px; }
.ov-progress {
    font-size: 13px; color: rgb(166, 186, 198); margin: 4px 0 6px 0;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}

/* --- the chain --- */
/* Only grows/shrinks when its `.ov-block-solo` parent is filling the page;
   inside a normal (non-solo) block it keeps its natural full height, same
   as before. */
.ov-chain { flex-grow: 1; flex-shrink: 1; min-height: 40px; }
.ov-chain-list { flex-direction: column; }
.ov-row {
    flex-direction: row; align-items: center; min-height: 48px; padding: 5px 10px; margin-bottom: 5px;
    background-color: rgb(19, 34, 46); border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 12px;
}
.ov-row--no { border-color: rgb(246, 146, 128); }
.ov-dot {
    width: 22px; height: 22px; flex-shrink: 0; border-radius: 11px; margin-right: 8px;
    -unity-text-align: middle-center; font-size: 13px; color: rgb(11, 23, 32);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-row--ok .ov-dot { background-color: rgb(159, 224, 194); }
.ov-row--no .ov-dot { background-color: rgb(246, 146, 128); }
.ov-row--wait .ov-dot { background-color: rgb(240, 195, 106); }
.ov-icon { width: 30px; height: 30px; flex-shrink: 0; margin-right: 8px; }
.ov-row-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ov-row-name {
    font-size: 15px; color: rgb(232, 242, 246);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-row-how { font-size: 13px; color: rgb(166, 186, 198); white-space: normal; }
.ov-row-qty {
    font-size: 14px; margin-left: 6px; flex-shrink: 0; -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-row--ok .ov-row-qty { color: rgb(159, 224, 194); }
.ov-row--no .ov-row-qty { color: rgb(246, 146, 128); }
.ov-row--wait .ov-row-qty { color: rgb(240, 195, 106); }

/* --- first step --- */
.ov-step {
    flex-direction: row; align-items: center; padding: 10px 12px; margin-top: 4px;
    background-color: rgb(19, 34, 46); border-width: 1.5px; border-color: rgb(164, 210, 232); border-radius: 12px;
}
.ov-step-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 10px; }
.ov-step-title {
    font-size: 14px; color: rgb(232, 242, 246); white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-step-detail { font-size: 13px; color: rgb(166, 186, 198); white-space: normal; }
.ov-go {
    height: 44px; min-width: 64px; padding: 0 14px; margin: 0; flex-shrink: 0;
    border-width: 0; border-radius: 10px; font-size: 14px;
    background-color: rgb(164, 210, 232); color: rgb(11, 23, 32);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-go:disabled { background-color: rgb(44, 74, 94); color: rgb(127, 151, 166); }

/* --- campfire card, being built, today --- */
.ov-card {
    flex-direction: column; padding: 12px; margin-bottom: 4px;
    background-color: rgb(26, 48, 64); border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 12px;
}
.ov-card-top { flex-direction: row; justify-content: space-between; align-items: flex-end; }
.ov-card-title {
    font-size: 17px; color: rgb(232, 242, 246);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-card-blurb { font-size: 13px; color: rgb(201, 216, 224); white-space: normal; margin-top: 4px; }
.ov-tiles { margin-top: 8px; }
.ov-tiles-row { flex-direction: row; }
.ov-tile {
    flex-grow: 1; flex-basis: 0; flex-direction: row; align-items: center; padding: 6px 8px; margin-right: 6px;
    background-color: rgb(19, 34, 46); border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 9px;
}
.ov-tile--short { border-color: rgb(246, 146, 128); }
.ov-tile-icon { width: 26px; height: 26px; margin-right: 6px; flex-shrink: 0; }
.ov-tile-name { font-size: 13px; color: rgb(166, 186, 198); margin-right: 6px; }
.ov-tile-q {
    font-size: 14px; color: rgb(232, 242, 246);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-tile--short .ov-tile-q { color: rgb(246, 146, 128); }
.ov-card-note {
    font-size: 13px; color: rgb(246, 146, 128); white-space: normal; margin-top: 8px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.ov-raise {
    height: 46px; margin: 8px 0 0 0; border-width: 0; border-radius: 10px; font-size: 15px;
    background-color: rgb(164, 210, 232); color: rgb(11, 23, 32);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-raise:disabled { background-color: rgb(44, 74, 94); color: rgb(127, 151, 166); }

.ov-line { font-size: 14px; color: rgb(201, 216, 224); white-space: normal; }
.ov-line-muted { font-size: 13px; color: rgb(166, 186, 198); margin-top: 2px; }
.ov-kv { flex-direction: row; justify-content: space-between; align-items: center; min-height: 22px; }
/* Tappable Today tiles (2026-09-27, candidate #6): Food/Stone/Watch open
   the sheet that answers them instead of sitting there as dead text. */
.ov-kv--tap {
    min-height: 44px; padding: 0 4px; margin: 0; border-width: 0; border-radius: 8px;
    background-color: transparent;
}
.ov-kv--tap:hover { background-color: rgb(26, 48, 64); }
.ov-kv-k { font-size: 14px; color: rgb(232, 242, 246); flex-shrink: 1; }
.ov-kv-v {
    font-size: 14px; color: rgb(232, 242, 246); margin-left: 8px; -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.ov-kv-v--bad { color: rgb(246, 146, 128); }
/* The goal chain's ScrollView: a slim dark thumb, no arrow buttons -- the
   default scroller drew a light-grey Unity bar with arrows (2026-09-27). */
.ov-chain .unity-scroller--vertical { width: 6px; margin-left: 4px; }
.ov-chain .unity-scroller__low-button, .ov-chain .unity-scroller__high-button { display: none; }
.ov-chain .unity-base-slider__tracker { background-color: rgb(19, 34, 46); border-width: 0; border-radius: 3px; }
.ov-chain .unity-base-slider__dragger { background-color: rgb(101, 136, 154); border-width: 0; border-radius: 3px; }
