/* The sheet HUD: parchment paper, ink, brass.
 *
 * Every colour in here is also in SheetTheme.cs, because C# has to reach some
 * of them (a bar's fill, a token's ring) and USS cannot be asked at runtime.
 * When Kevin retunes, both move together -- that pairing is the only thing
 * this file asks a reader to remember.
 *
 * Fonts are referenced by project path rather than through Resources: a TTF
 * under Art/Fonts is not loadable by Resources.Load, and a stylesheet keeps a
 * real asset reference, so the font ships with the build without a second copy.
 */

/* ---------------- root ---------------- */

.sheet-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------------- the card ---------------- */

.sheet-card {
    position: absolute;
    background-color: rgb(244, 232, 207);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(31, 45, 56);
    padding: 0;
    overflow: hidden;
}

/* The inner 1px rule, inset ~6px. A second element rather than a second
 * border, because UI Toolkit gives an element exactly one. */
.sheet-inner {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
    border-width: 1px;
    border-color: rgba(31, 45, 56, 0.35);
    border-radius: 4px;
}

.sheet-shadow {
    position: absolute;
    background-color: rgba(18, 26, 32, 0.28);
    border-radius: 10px;
}

/* The body is the pager's viewport: it fills whatever the header, the strip
 * and the action row leave, and it CLIPS. Nothing in it scrolls -- a page
 * that does not fit is a page the sheet was supposed to split (see
 * `SheetHost.BandHeight`). */
.sheet-body {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 14px;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

/* Portrait: the card docks to the bottom edge, full width, and scrolls. */
.sheet-card--docked {
    border-radius: 12px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

/* Kept for anything still asking for it; there is no scroll view in the
 * frame any more. */
.sheet-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* ---------------- the tail ---------------- */

.sheet-tail {
    position: absolute;
    height: 2px;
    background-color: rgb(31, 45, 56);
    transform-origin: left center;
}

.sheet-tail-dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: rgb(244, 232, 207);
    border-width: 2px;
    border-color: rgb(31, 45, 56);
}

/* ---------------- header ---------------- */

.sheet-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.sheet-badge {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    align-items: center;
    justify-content: center;
}

.sheet-badge-glyph {
    font-size: 16px;
    color: rgb(244, 232, 207);
    -unity-text-align: middle-center;
}

.sheet-title {
    font-size: 22px;
    color: rgb(31, 45, 56);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Fraunces-Black.ttf");
    -unity-font-style: normal;
    white-space: normal;
}

.sheet-eyebrow {
    font-size: 12px;
    letter-spacing: 1.2px;
    color: rgba(31, 45, 56, 0.62);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
    margin-bottom: 2px;
}

.sheet-close {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    flex-shrink: 0;
    border-width: 2px;
    border-color: rgba(31, 45, 56, 0.45);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(31, 45, 56);
    font-size: 13px;
    margin: 0;
    padding: 0;
}

.sheet-close:hover {
    background-color: rgba(31, 45, 56, 0.08);
}

/* ---------------- words ---------------- */

.sheet-text {
    font-size: 13px;
    color: rgb(31, 45, 56);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
    white-space: normal;
}

.sheet-muted {
    color: rgba(31, 45, 56, 0.62);
}

.sheet-rule {
    height: 1px;
    background-color: rgba(31, 45, 56, 0.22);
    margin-top: 8px;
    margin-bottom: 8px;
}

/* ---------------- layout ---------------- */

.sheet-row {
    flex-direction: row;
    align-items: center;
}

.sheet-col {
    flex-direction: column;
}

/* ---------------- buttons ---------------- */

.sheet-btn {
    height: 38px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(31, 45, 56);
    background-color: rgba(31, 45, 56, 0.04);
    color: rgb(31, 45, 56);
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
    padding-left: 12px;
    padding-right: 12px;
    margin: 0;
    white-space: normal;
}

.sheet-btn:hover {
    background-color: rgba(31, 45, 56, 0.10);
}

.sheet-btn--primary {
    background-color: rgb(201, 147, 57);
    border-color: rgb(138, 97, 32);
    color: rgb(31, 45, 56);
}

.sheet-btn--primary:hover {
    background-color: rgb(214, 162, 74);
}

.sheet-btn--quiet {
    height: 26px;
    font-size: 13px;
    border-width: 1px;
    border-color: rgba(31, 45, 56, 0.45);
    background-color: rgba(0, 0, 0, 0);
}

/* ---------------- tokens ---------------- */

.sheet-token {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 2px;
    flex-shrink: 0;
    background-color: rgb(31, 45, 56);
    align-items: center;
    justify-content: center;
}

.sheet-token-letter {
    font-size: 15px;
    color: rgb(244, 232, 207);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Fraunces-Black.ttf");
    -unity-text-align: middle-center;
}

.sheet-token-job {
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    padding: 0;
    background-color: rgb(244, 232, 207);
    border-width: 1px;
    border-color: rgb(31, 45, 56);
    color: rgb(31, 45, 56);
    font-size: 13px;
    -unity-text-align: middle-center;
}

/* ---------------- stores ---------------- */

.sheet-store {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 86px;
    overflow: hidden;
}

.sheet-store-big {
    font-size: 22px;
    color: rgb(31, 45, 56);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}

.sheet-store-small {
    font-size: 13px;
    color: rgba(31, 45, 56, 0.62);
    margin-left: 4px;
    margin-bottom: 3px;
    flex-shrink: 1;
}

/* ---------------- bars ---------------- */

.sheet-bar {
    background-color: rgba(31, 45, 56, 0.16);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 6px;
}

.sheet-bar-fill {
    height: 100%;
    border-radius: 3px;
}

/* ---------------- note ---------------- */

.sheet-note {
    flex-direction: row;
    align-items: flex-start;
    background-color: rgba(31, 45, 56, 0.06);
    border-width: 1px;
    border-color: rgba(31, 45, 56, 0.30);
    border-radius: 6px;
    padding: 9px;
}

.sheet-note-glyph {
    color: rgb(201, 147, 57);
    font-size: 13px;
    margin-right: 8px;
}

.sheet-note-text {
    color: rgb(31, 45, 56);
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
    white-space: normal;
    flex-shrink: 1;
}

/* ---------------- segmented ---------------- */

.sheet-seg {
    flex-direction: row;
    background-color: rgba(31, 45, 56, 0.10);
    border-radius: 16px;
    padding: 3px;
}

.sheet-seg-btn {
    height: 26px;
    flex-grow: 1;
    border-radius: 13px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(31, 45, 56, 0.62);
    font-size: 13px;
    margin: 0;
}

.sheet-seg-btn--on {
    background-color: rgb(201, 147, 57);
    color: rgb(31, 45, 56);
}

/* ---------------- the ashore rail ---------------- */

.sheet-rail {
    position: absolute;
    flex-direction: column;
    align-items: flex-start;
    background-color: rgb(19, 34, 46);
    border-radius: 30px;
    border-width: 2px;
    border-color: rgb(31, 45, 56);
    padding: 7px;
}

.sheet-rail > .sheet-token {
    margin-left: 4px;
}

.sheet-rail-hidden {
    display: none;
}

.sheet-rail-label {
    font-size: 12px;
    letter-spacing: 1.2px;
    color: rgba(31, 45, 56, 0.62);
    rotate: -90deg;
    width: 14px;
    -unity-text-align: middle-center;
}

/* ---------------- the place label ---------------- */

.sheet-place {
    position: absolute;
    flex-direction: column;
    align-items: flex-start;
    width: auto;
}

.sheet-place-name {
    font-size: 30px;
    white-space: nowrap;
    width: auto;
    color: rgb(244, 232, 207);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Fraunces-Black.ttf");
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.55);
}

.sheet-place-sub {
    font-size: 12px;
    white-space: nowrap;
    width: auto;
    letter-spacing: 1.6px;
    color: rgb(244, 232, 207);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
}

/* ---------------- the chart instrument ----------------
 *
 * The dial itself is one Painter2D mesh; only the four cardinals and the tab
 * under it are real elements, because Painter2D cannot draw text and these
 * letters want the same storybook serif as the rest of the HUD.
 */

.chart {
    position: absolute;
}

.chart-cardinal {
    position: absolute;
    width: 18px;
    height: 18px;
    font-size: 13px;
    color: rgb(31, 45, 56);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Fraunces-Black.ttf");
    -unity-text-align: middle-center;
}

.chart-cardinal--n {
    font-size: 13px;
}

.chart-tab {
    position: absolute;
    left: 0;
    flex-direction: column;
    align-items: flex-start;
    background-color: rgb(19, 34, 46);
    border-radius: 999px;
    border-width: 2px;
    border-color: rgb(31, 45, 56);
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 4px;
    padding-bottom: 4px;
}

/* One line, and the pill sizes to it (2026-10-03): wrapped inside the
 * chart's narrow box, "heavy to the south-west" broke onto a second line
 * the pill did not grow for, and "west" hung outside it. */
.chart-tab-text {
    font-size: 17px;
    color: rgb(244, 232, 207);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
    white-space: nowrap;
}

.chart-tab-weather {
    color: rgb(188, 201, 213);
    margin-left: 0px;
}

/* ---------------- the standard frame ----------------
 *
 * One sheet, tabs (2026-09-22). The card is a fixed region of the screen and
 * these are the four bands inside it: a header that does not scroll, a tab
 * strip, the body (the only thing that scrolls) and an action row pinned to
 * the bottom edge. The body's padding lives here rather than on `.sheet-body`
 * alone so the header and the action row line up with it exactly.
 */

/* The card as a frame: four bands stacked, and nothing allowed to spill.
 * The card's HEIGHT is set from C# (a third of the safe area) rather than
 * from content, so `overflow: hidden` here is what stops a long body from
 * painting past the paper while the scroll view catches up. */
.sheet-frame {
    flex-direction: column;
    overflow: hidden;
}

.sheet-frame-head {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    flex-shrink: 0;
}

.sheet-tabs {
    flex-direction: row;
    flex-shrink: 0;
    padding-left: 14px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(31, 45, 56, 0.22);
}

/* 44px is the thumb floor this project holds every touch target to. */
.sheet-tab {
    min-height: 44px;
    flex-grow: 1;
    flex-basis: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(31, 45, 56, 0.55);
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
    margin: 0;
    padding: 2px 2px;
    white-space: normal;
}

.sheet-tab:hover {
    background-color: rgba(31, 45, 56, 0.06);
}

.sheet-tab--on {
    color: rgb(31, 45, 56);
    background-color: rgba(31, 45, 56, 0.05);
}

/* The accent underline. Invisible until the tab is live -- the colour is set
 * from C# (the sheet's own accent), the SHOWING is done here. */
.sheet-tab-mark {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 0;
    height: 3px;
    border-radius: 2px;
    display: none;
}

.sheet-tab--on > .sheet-tab-mark {
    display: flex;
}

.sheet-actions {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-top-color: rgba(31, 45, 56, 0.22);
}

/* ---------------- chips ---------------- */

.sheet-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(31, 45, 56, 0.05);
    border-width: 1px;
    border-color: rgba(31, 45, 56, 0.22);
    border-radius: 6px;
    padding-left: 0;
    padding-right: 9px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-right: 6px;
    margin-bottom: 6px;
    overflow: hidden;
}

.sheet-chip-stripe {
    width: 4px;
    height: 26px;
    border-radius: 2px;
    margin-right: 8px;
    flex-shrink: 0;
}

.sheet-chip-value {
    font-size: 14px;
    color: rgb(31, 45, 56);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
    white-space: normal;
}

/* ---------------- the pager strip ----------------
 *
 * Five tabs is the most a 44 px row can hold and still be aimed at with a
 * thumb, so a sheet with more pages than that gets the compact strip
 * instead: two arrows, the live page's name, and a dot per page. The swipe
 * is the real control either way -- this is the map of where you are.
 */

.sheet-tabs--compact {
    align-items: center;
    justify-content: space-between;
}

.sheet-tab-arrow {
    width: 44px;
    height: 44px;
    flex-grow: 0;
    flex-shrink: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(31, 45, 56);
    font-size: 20px;
    margin: 0;
    padding: 0;
}

.sheet-tab-arrow:hover {
    background-color: rgba(31, 45, 56, 0.06);
}

.sheet-tab-arrow:disabled {
    opacity: 0.3;
}

.sheet-tab-now {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    color: rgb(31, 45, 56);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
    -unity-text-align: middle-center;
    white-space: normal;
}

.sheet-dots {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 44px;
}

.sheet-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    margin-left: 3px;
    margin-right: 3px;
    background-color: rgba(31, 45, 56, 0.25);
    flex-shrink: 0;
}

/* A row in a list. 40 px is a MINIMUM (`SheetKit.RowPx`), never a fixed
 * height (Kevin, permanent: text is never cut off): a row whose label wraps
 * grows to fit it, and the list around it (a ScrollView, or a hugging frame)
 * grows or scrolls with it. Nothing pages by this height -- the one list that
 * uses the row (`GatherSheet`'s "on it") scrolls -- so growing cannot push a
 * row off a page. `overflow` stays visible so a row never clips its own text. */
.sheet-list-row {
    flex-direction: row;
    align-items: center;
    height: auto;
    min-height: 40px;
    flex-shrink: 0;
}

/* ---------------- the hugging frame (Kevin, 2026-09-30) ----------------
 *
 * "Not every menu should be full screen. This is so much empty space. And I
 * would like to see the building I'm pressing on." On the phone with the land
 * HUD up, a structure's sheet sits in a frame as tall as its content and never
 * past half the screen (`SheetHost.HugsContent`, which puts `.sheet-fit` on the
 * card). These rules condense the `.st` page kit inside it: a 48-unit header
 * instead of 56, no second padded panel around the page, tighter section gaps,
 * and the station's recipe card with its picture as an icon in the name row.
 * Every touch target stays at 44 or more. Rules here sit in the root sheet and
 * out-rank Station.uss / Hand.uss / Lookout.uss on specificity alone.
 */
.sheet-fit .sheet-frame-head { padding-top: 10px; }
.sheet-fit .sheet-body { padding-top: 8px; padding-bottom: 10px; }
.sheet-fit .st-page { padding: 0; background-color: rgba(0, 0, 0, 0); border-radius: 0; }

.sheet-fit .st-head { margin-bottom: 8px; }
.sheet-fit .st .st-square { width: 48px; height: 48px; border-radius: 12px; }
.sheet-fit .st .lk-glyph-box { width: 48px; height: 48px; border-radius: 12px; }
.sheet-fit .st .lk-glyph { width: 30px; height: 30px; }
.sheet-fit .st .st-title { font-size: 24px; }
.sheet-fit .st .st-sub { font-size: 15px; margin-top: 0; }
.sheet-fit .st .st-pill { height: 32px; padding: 0 12px; }

.sheet-fit .st .st-section { margin-top: 8px; }
.sheet-fit .st .st-upgrade { margin-top: 10px; }
.sheet-fit .st .st-btn { height: auto; min-height: 48px; }
.sheet-fit .st .st-seg-btn { height: 48px; }
.sheet-fit .st .st-seg { padding: 3px; border-radius: 14px; }
.sheet-fit .st .st-worker-person { min-height: 48px; }
.sheet-fit .st .st-avatar { width: 44px; height: 44px; border-radius: 22px; }

/* the compact recipe card: icon in the name row, smaller type */
.sheet-fit .st .st-recipe { padding: 10px; }
.sheet-fit .st .st-recipe--on { padding: 9px; }
.sheet-fit .st .st-recipe--locked { padding: 12px; }
.sheet-fit .st .st-recipe--row2 { margin-top: 8px; }
.sheet-fit .st .st-name-row { align-items: center; justify-content: flex-start; margin-bottom: 4px; }
.st-name-icon { width: 30px; height: 30px; margin-right: 6px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.sheet-fit .st .st-recipe--locked .st-name-icon { opacity: 0.4; }
.sheet-fit .st .st-recipe-name { font-size: 17px; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.sheet-fit .st .st-yield { font-size: 15px; }
.sheet-fit .st .st-takes { margin-bottom: 4px; min-height: 20px; }
.sheet-fit .st .st-takes-text { font-size: 14px; }
.sheet-fit .st .st-recipe .st-small-icon { width: 18px; height: 18px; margin-right: 4px; }
/* the running order's bar becomes a 4-unit strip along the card's foot */
.sheet-fit .st .st-recipe .st-bar { position: absolute; left: 12px; right: 12px; bottom: 5px; height: 4px; margin: 0; border-radius: 2px; }
.sheet-fit .st .st-recipe .st-bar-fill { height: 4px; }
.sheet-fit .st .st-recipe-state { font-size: 14px; min-height: 18px; }
.sheet-fit .st .st-dots { margin-top: 0; }
.sheet-fit .st .st-dot-btn { height: 28px; }

/* in and out */
.sheet-fit .st .st-flow { padding: 8px 8px; }
.sheet-fit .st .st-flow-icon { width: 36px; height: 36px; }
.sheet-fit .st .st-ring { width: 36px; height: 36px; }

/* The fishing hut's bench cell says where he is ("at the shore"), words not
 * a percentage, so it wraps inside its third of the card (2026-09-30). */
.st .st-flow-cell .st-flow-value--words { font-size: 16px; white-space: normal; -unity-text-align: middle-center; }
