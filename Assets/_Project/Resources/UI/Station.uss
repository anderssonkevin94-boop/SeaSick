/* ------------------------------------------------------------------
 * The station page (concept A2, Kevin approved the Melvor-style
 * redesign 2026-09-27). One full-height page per production building:
 * header -> worker card -> recipe cards -> the order -> in and out ->
 * why it stopped -> upgrade. Mockup: LedgerStation (390x844 pt).
 *
 * Every size here is PANEL UNITS, not mockup pixels. On the phone one
 * panel unit is ~0.7 pt (DEV-TOOLS: ~2.05 game-view px a unit on a 3x
 * iPhone), so the mockup's numbers are scaled ~1.3x and its 20-pt gaps
 * tightened to 14 so the whole page fits the tall band without a scroll.
 * Loaded by `StationSheet`/`FarmSheet` onto their own roots only; every
 * selector is under `.st` so nothing here reaches another sheet.
 * ------------------------------------------------------------------ */

.st .unity-label {
    color: rgb(232, 242, 246);
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
    margin: 0;
    padding: 0;
}

.st-page {
    background-color: rgb(15, 27, 37);
    border-radius: 14px;
    padding: 10px 10px 12px 10px;
    flex-direction: column;
}

.st-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.st-content { flex-direction: column; flex-grow: 1; }
.st-section { flex-direction: column; margin-top: 14px; flex-shrink: 0; }

.st .st-black { -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st .st-muted { color: rgb(166, 186, 198); }
.st .st-eyebrow {
    font-size: 14px;
    color: rgb(127, 151, 166);
    letter-spacing: 1.6px;
    margin-bottom: 8px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}

/* --- the header ------------------------------------------------------ */

.st-head { flex-direction: row; align-items: center; margin-bottom: 10px; }
.st-head-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 12px; margin-right: 8px; }
.st .st-title { font-size: 29px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); white-space: normal; }
.st .st-sub { font-size: 17px; color: rgb(166, 186, 198); margin-top: 2px; }

.st .st-square {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 14px;
    background-color: rgb(19, 34, 46);
    border-width: 2px;
    border-color: rgb(44, 74, 94);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}
.st .st-square:hover { background-color: rgb(26, 48, 64); }
.st .st-square:disabled { opacity: 0.35; }
.st-glyph { width: 26px; height: 26px; }

.st-pill {
    height: 36px;
    padding: 0 16px;
    border-radius: 18px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 10px;
    background-color: rgb(31, 74, 60);
}
.st .st-pill-text { font-size: 15px; color: rgb(159, 224, 194); -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st-pill--wait { background-color: rgb(74, 58, 26); }
.st .st-pill--wait .st-pill-text { color: rgb(240, 195, 106); }
.st-pill--bad { background-color: rgb(74, 35, 32); }
.st .st-pill--bad .st-pill-text { color: rgb(246, 146, 128); }

/* --- cards and buttons ---------------------------------------------- */

.st-card {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px;
    background-color: rgb(19, 34, 46);
    border-width: 2px;
    border-color: rgb(30, 51, 68);
    border-radius: 18px;
    flex-shrink: 0;
}

.st .st-btn {
    height: auto;
    min-height: 56px;
    padding: 4px 20px;
    margin: 0 0 0 8px;
    border-radius: 13px;
    white-space: normal;
    background-color: rgb(26, 48, 64);
    border-width: 2px;
    border-color: rgb(44, 74, 94);
    color: rgb(232, 242, 246);
    font-size: 18px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-btn:hover { background-color: rgb(34, 60, 78); }
.st .st-btn:disabled { opacity: 0.4; }

/* --- the worker ------------------------------------------------------- */

.st-avatar {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgb(44, 74, 94);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.st .st-avatar-text { font-size: 22px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st-worker-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; margin-left: 14px; }
.st .st-worker-name { font-size: 20px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); white-space: normal; }
.st .st-worker-sub { font-size: 16px; color: rgb(166, 186, 198); white-space: normal; }

/* Tap the person: avatar + name + chevron, same row the slot's verbs sit
   beside. A plain Button reset to the row it replaces so it carries no
   button chrome of its own -- the avatar and the text still read as the
   worker card always did. min-height keeps the tap target >=44pt even
   though the avatar alone is 52px. */
.st .st-worker-person {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 52px;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}
.st .st-worker-person:hover { opacity: 0.85; }
.st .st-worker-person:disabled { opacity: 1; }
.st .st-worker-chevron {
    font-size: 20px;
    color: rgb(166, 186, 198);
    flex-shrink: 0;
    margin-left: 6px;
}

/* --- recipes ---------------------------------------------------------- */

.st-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.st-recipe {
    width: 48.5%;
    padding: 12px;
    margin-bottom: 0;
    background-color: rgb(19, 34, 46);
    border-width: 2px;
    border-color: rgb(44, 74, 94);
    border-radius: 18px;
    flex-direction: column;
    flex-shrink: 0;
}
.st-recipe--row2 { margin-top: 12px; }
.st-recipe--on { background-color: rgb(26, 48, 64); border-color: rgb(164, 210, 232); border-width: 3px; padding: 11px; }
.st-recipe--locked { border-width: 0; padding: 14px; }
.st-tile {
    height: 72px;
    background-color: rgb(14, 26, 36);
    border-radius: 13px;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}
.st-tile-icon { width: 56px; height: 56px; -unity-background-scale-mode: scale-to-fit; }
.st-recipe--locked .st-tile-icon { opacity: 0.4; }
.st-name-row { flex-direction: row; align-items: flex-end; justify-content: space-between; margin-bottom: 6px; }
.st .st-recipe-name { font-size: 20px; flex-shrink: 1; min-width: 0; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); white-space: normal; }
.st .st-recipe--locked .st-recipe-name { color: rgb(166, 186, 198); }
.st .st-yield { font-size: 17px; color: rgb(166, 186, 198); margin-left: 6px; }
.st .st-recipe--locked .st-yield { color: rgb(110, 132, 148); }
.st-takes { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 8px; min-height: 24px; }
.st-small-icon { width: 22px; height: 22px; margin-right: 5px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.st .st-takes-text { font-size: 16px; color: rgb(201, 216, 224); margin-right: 6px; }
.st .st-recipe--locked .st-takes-text { color: rgb(166, 186, 198); }
.st-bar { height: 8px; background-color: rgb(14, 26, 36); border-radius: 4px; overflow: hidden; margin-bottom: 6px; }
.st-bar-fill { height: 8px; background-color: rgb(159, 224, 194); width: 0; }
.st .st-recipe-state { font-size: 15px; color: rgb(166, 186, 198); min-height: 20px; white-space: normal; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st .st-state--make { color: rgb(159, 224, 194); }
.st .st-state--wait { color: rgb(240, 195, 106); }
.st .st-state--lock { color: rgb(246, 146, 128); }

.st-dots { flex-direction: row; justify-content: center; margin-top: 4px; }
.st .st-dot-btn {
    width: 44px;
    height: 32px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}
.st-dot { width: 10px; height: 10px; border-radius: 5px; background-color: rgb(44, 74, 94); }
.st-dot--on { background-color: rgb(164, 210, 232); }

/* --- the order -------------------------------------------------------- */

.st-seg {
    flex-direction: row;
    padding: 5px;
    background-color: rgb(11, 22, 32);
    border-width: 2px;
    border-color: rgb(30, 51, 68);
    border-radius: 18px;
    flex-shrink: 0;
}
.st .st-seg-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 56px;
    margin: 0 0 0 5px;
    padding: 0;
    border-radius: 13px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(232, 242, 246);
    font-size: 19px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-seg-btn--first { margin-left: 0; }
.st .st-seg-btn:hover { background-color: rgba(164, 210, 232, 0.08); }
.st .st-seg-btn--inf { font-size: 24px; }
.st .st-seg-btn--on { background-color: rgb(164, 210, 232); color: rgb(11, 23, 32); }
.st .st-seg-btn--on:hover { background-color: rgb(194, 228, 242); }
.st .st-seg-btn--stop {
    flex-grow: 1.3;
    border-width: 2px;
    border-color: rgb(246, 146, 128);
    background-color: rgb(42, 26, 26);
    color: rgb(246, 146, 128);
    font-size: 18px;
}
.st .st-seg-btn--stop:hover { background-color: rgb(58, 34, 34); }
.st .st-seg-btn:disabled { opacity: 0.35; }

/* --- in and out ------------------------------------------------------- */

.st-flow { padding: 12px 8px; }
.st-flow-cell { flex-grow: 1; flex-basis: 0; flex-direction: column; align-items: center; }
.st-flow-icon { width: 44px; height: 44px; -unity-background-scale-mode: scale-to-fit; margin-bottom: 4px; }
.st-ring { width: 44px; height: 44px; margin-bottom: 4px; }
.st .st-flow-value { font-size: 20px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st .st-flow-label { font-size: 15px; color: rgb(166, 186, 198); }
.st-arrow { width: 24px; height: 24px; flex-shrink: 0; }

.st .st-stall { font-size: 16px; color: rgb(246, 146, 128); margin-top: 10px; white-space: normal; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }

/* --- the farm's beds -------------------------------------------------- */

.st-beds { flex-direction: row; margin-bottom: 10px; }
.st-bed { width: 36px; height: 36px; border-radius: 9px; margin-right: 8px; border-width: 2px; border-color: rgb(44, 74, 94); background-color: rgb(14, 26, 36); }
.st-bed--ripe { background-color: rgb(159, 224, 194); border-color: rgb(159, 224, 194); }
.st-bed--cut { background-color: rgb(74, 58, 26); }
.st-col { flex-direction: column; flex-grow: 1; }
.st .st-line { font-size: 17px; }

/* --- upgrade ---------------------------------------------------------- */

.st-upgrade { border-color: rgb(107, 82, 32); margin-top: 14px; flex-direction: column; align-items: stretch; }
.st-upgrade-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.st .st-upgrade-title { font-size: 19px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); white-space: normal; }
.st-cost { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 6px; }
.st-chip { flex-direction: row; align-items: center; margin-right: 12px; }
.st .st-cost-text { font-size: 16px; margin-right: 0; }
.st .st-cost--ok { color: rgb(159, 224, 194); }
.st .st-cost--short { color: rgb(246, 146, 128); }
/* The ONE button on the card: amber "Raise to level N" (the fix is the Slot's ice button). */
.st .st-upgrade-btn { margin: 10px 0 0 0; height: auto; min-height: 48px; font-size: 17px; padding: 0 16px; white-space: normal; }
.st .st-upgrade-btn--go { background-color: rgb(240, 195, 106); color: rgb(30, 26, 16); border-color: rgb(240, 195, 106); }
.st .st-upgrade-btn--go:hover { background-color: rgb(248, 214, 140); }
/* Plain ember words -- clearly not a button (no fill, no border). */
.st .st-upgrade-status { font-size: 16px; color: rgb(246, 146, 128); margin-top: 8px; white-space: normal; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
/* A text link: lesser than any button (no fill, no border), 40 px tall to hit. */
.st .st-link {
    align-self: flex-start; min-height: 40px; margin: 2px 0 0 -6px; padding: 0 6px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 8px;
    color: rgb(164, 210, 232); font-size: 15px; white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Bold.ttf");
}
.st .st-link:hover { background-color: rgb(32, 57, 72); }
.st .st-pin--on { color: rgb(159, 224, 194); }

/* --- the store hut's tiles ------------------------------------------------ */

.st-store-card { flex-direction: column; align-items: stretch; }
.st-store-grid { flex-direction: row; flex-wrap: wrap; }
.st-store-tile {
    width: 23.5%; margin: 0 2% 8px 0; padding: 6px 4px 6px 4px; flex-direction: column; align-items: stretch;
    background-color: rgb(26, 48, 64); border-width: 1.5px; border-color: rgb(44, 74, 94); border-radius: 9px;
}
.st-store-tile--end { margin-right: 0; }
.st-store-top { flex-direction: row; align-items: center; justify-content: center; height: 30px; }
.st-store-icon { width: 26px; height: 26px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.st .st-store-count { font-size: 14px; color: rgb(232, 242, 246); margin: 0 0 0 3px; white-space: nowrap; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st-store-bar { height: 4px; margin: 4px 4px 0 4px; background-color: rgb(14, 26, 36); border-radius: 2px; overflow: hidden; }
.st-store-fill { height: 4px; width: 0; background-color: rgb(159, 224, 194); }
.st-store-tile--full { border-color: rgb(246, 146, 128); }
.st-store-tile--full .st-store-fill { background-color: rgb(246, 146, 128); }
.st .st-store-tile--full .st-store-count { color: rgb(246, 146, 128); }
.st-store-foot { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 0; }
.st .st-store-holds { font-size: 15px; color: rgb(166, 186, 198); flex-shrink: 1; white-space: normal; }

/* Leave space for the worker slot on a portrait phone. */
.st .st-worker-assign { max-width: 140px; padding: 0 10px; white-space: normal; font-size: 16px; }

/* ------------------------------------------------------------------
 * The station screen, Melvor-style (Kevin approved 2026-09-30, island
 * UI phase 5; mockups "5 · Kitchen (Melvor)" / "5b · Cauldron picked").
 * Spot tiles (Grill | Cauldron) -> a four-a-row recipe grid for the
 * viewed spot -> the tapped recipe's detail; the Select / Stop thumb row
 * is the host's action row (`StationSheet.BuildActions`). Sized for the
 * land panel (430 x 932 reference, ~1 unit a point), so the mockup's
 * numbers carry over nearly 1:1; `StationSheet.SpotRowPx` / `TileRowPx`
 * / `DetailPx` are the sums of these rules -- change them together.
 * Tiles are Buttons (so `SheetHost.ClippedControls` sees them): every
 * rule resets Unity's button chrome, :hover:active included.
 * ------------------------------------------------------------------ */

/* --- spot tiles -------------------------------------------------------- */

.st-spots { flex-direction: row; margin-bottom: 8px; flex-shrink: 0; }
.st .st-spot {
    flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 44px;
    flex-direction: column; align-items: stretch; justify-content: flex-start;
    margin: 0 0 0 8px; padding: 8px 10px;
    border-radius: 14px; border-width: 2px; border-color: rgb(44, 74, 94);
    background-color: rgb(28, 52, 70);
}
.st .st-spot--first { margin-left: 0; }
.st .st-spot:hover, .st .st-spot:hover:active { background-color: rgb(34, 60, 80); }
.st .st-spot--on { border-color: rgb(164, 210, 232); }
.st-spot-top { flex-direction: row; align-items: center; }
.st-spot-glyph { width: 22px; height: 22px; flex-shrink: 0; margin-right: 7px; }
.st .st-spot-name {
    font-size: 16px; flex-shrink: 1; min-width: 0;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-spot-status {
    font-size: 13px; margin-top: 4px; color: rgb(166, 186, 198);
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st-spot-bar { height: 5px; margin-top: 5px; border-radius: 3px; background-color: rgb(44, 74, 94); overflow: hidden; }
.st-spot-fill { height: 5px; width: 0; background-color: rgb(156, 210, 122); }
.st-spot-fill--wait { background-color: rgb(242, 196, 109); }

/* --- the recipe grid ------------------------------------------------- */

.st .st-grid-eyebrow { font-size: 12px; margin-bottom: 6px; }
.st-rgrid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 8px; }
.st .st-rtile {
    width: 23.5%; min-height: 80px; margin: 0 2% 0 0; padding: 7px 2px 6px 2px;
    flex-direction: column; align-items: center; justify-content: flex-start;
    border-radius: 12px; border-width: 1.5px; border-color: rgb(44, 74, 94);
    background-color: rgb(28, 52, 70);
}
.st .st-rtile:hover, .st .st-rtile:hover:active { background-color: rgb(34, 60, 80); }
.st .st-rtile--end { margin-right: 0; }
.st .st-rtile--row2 { margin-top: 7px; }
.st .st-rtile--run { border-color: rgb(156, 210, 122); }
.st .st-rtile--locked { background-color: rgb(22, 41, 58); border-width: 0; }
/* the tapped tile: the thick ice border, over run and locked alike */
.st .st-rtile--on { border-width: 2.5px; border-color: rgb(164, 210, 232); background-color: rgb(36, 62, 82); }
.st-rtile-icon { width: 28px; height: 28px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.st-rtile-glyph { width: 26px; height: 26px; flex-shrink: 0; margin: 1px 0 1px 0; }
.st .st-rtile-name {
    font-size: 13px; margin-top: 3px; white-space: normal; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-rtile--locked .st-rtile-name { color: rgb(166, 186, 198); }
.st .st-rtile-status {
    font-size: 11px; margin-top: 2px; color: rgb(166, 186, 198);
    white-space: normal; -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-badge {
    font-size: 10px; margin-top: 3px; padding: 1px 5px; border-radius: 6px;
    background-color: rgb(156, 210, 122); color: rgb(11, 23, 32); letter-spacing: 0.5px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-badge--wait { background-color: rgb(242, 196, 109); }
.st-rtile-bar {
    position: absolute; left: 8px; right: 8px; bottom: 3px; height: 3px;
    border-radius: 2px; background-color: rgb(44, 74, 94); overflow: hidden;
}
.st-rtile-fill { height: 3px; width: 0; background-color: rgb(156, 210, 122); }

/* --- the detail -------------------------------------------------------- */

.st-detail {
    flex-direction: column; flex-shrink: 0; padding: 10px 12px;
    border-radius: 14px; border-width: 1px; border-color: rgb(44, 74, 94);
    background-color: rgb(28, 52, 70);
}
.st-detail-head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
.st .st-detail-name {
    font-size: 17px; flex-shrink: 1; min-width: 0;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-detail-time { font-size: 13px; color: rgb(166, 186, 198); margin-left: 8px; flex-shrink: 0; }
.st-detail-io { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 6px; }
.st-io-chip {
    flex-direction: row; align-items: center; padding: 3px 8px; margin: 0 6px 4px 0;
    border-radius: 8px; background-color: rgb(22, 41, 58);
}
.st-io-icon { width: 18px; height: 18px; margin-right: 4px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.st .st-io-text { font-size: 13px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf"); }
.st-io-arrow { width: 16px; height: 16px; margin: 0 6px 4px 0; flex-shrink: 0; }
.st-detail-foot { flex-direction: row; align-items: center; margin-top: 2px; }
.st .st-detail-line { font-size: 13px; color: rgb(166, 186, 198); flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: normal; }
/* the fix as a text link on the right: "Gather ore →", 44 tall to hit */
.st .st-detail-fix {
    align-self: center; flex-shrink: 0; min-height: 44px; margin: 0 -6px 0 8px;
    font-size: 14px; -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}

/* --- tones: last, so they win over each piece's own muted colour ------- */

.st .st-tone--good { color: rgb(156, 210, 122); }
.st .st-tone--wait { color: rgb(242, 196, 109); }
.st .st-tone--bad { color: rgb(246, 146, 128); }

/* ------------------------------------------------------------------
 * The farm (rework 2026-10-04, Kevin's phone verdict "Farm plot UI is
 * broken"). Plots page: a "No farmer · Assign" card when nobody works
 * the field, then plot cards three a row (crop icon | name, state,
 * "next: X"), then one summary line. Tap a plot: its detail takes the
 * grid's place -- "‹ Plots" + the plot's state, the crop cards (icon,
 * name, a harvest, time · per hour), one wrapping info line and ONE row
 * of real buttons (Replant toggle · Clear plot). Every height here is
 * summed into `FarmSheet.PlotRowPx` / `FarmerRowPx` -- change together.
 * Nothing has a fixed height: text wraps, the card grows.
 * ------------------------------------------------------------------ */

.st-pgrid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.st .st-ptile {
    width: 32%; min-height: 56px; margin: 0 2% 0 0; padding: 5px 3px 5px 5px;
    flex-direction: row; align-items: center; justify-content: flex-start; flex-shrink: 0;
    border-radius: 12px; border-width: 1.5px; border-color: rgb(44, 74, 94);
    background-color: rgb(28, 52, 70);
}
.st .st-ptile:hover, .st .st-ptile:hover:active { background-color: rgb(34, 60, 80); }
.st .st-ptile--end { margin-right: 0; }
.st .st-ptile--row2 { margin-top: 7px; }
.st .st-ptile--ripe { border-color: rgb(156, 210, 122); }
/* an empty plot: the ice edge says "tap me", its line says what for */
.st .st-ptile--empty { border-color: rgb(164, 210, 232); background-color: rgb(22, 41, 58); }
.st .st-ptile--locked { background-color: rgb(22, 41, 58); border-color: rgb(30, 51, 68); }
.st .st-ptile--on { border-width: 2.5px; border-color: rgb(164, 210, 232); background-color: rgb(36, 62, 82); }
/* The crop icon is the card's height (Kevin 2026-10-04: "they read tiny"):
 * 36 against two text lines of ~38. A card is ~124 units wide on the 16 Pro,
 * so 3+8 chrome + 36 + 5 leaves ~72 for the words: every plot line measured
 * in Nunito fits one line ("next: Potato" 68, "16:25 left" 61, "10 to pick"
 * 62); only "Choose crop" (78) wraps, at its space. */
.st-ptile-icon { width: 36px; height: 36px; flex-shrink: 0; margin-right: 5px; -unity-background-scale-mode: scale-to-fit; }
.st-ptile-glyph { width: 28px; height: 28px; flex-shrink: 0; margin: 4px 9px 4px 4px; }
.st .st-ptile--locked .st-ptile-icon { opacity: 0.35; }
.st-ptile-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.st .st-ptile-name {
    font-size: 15px; white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-ptile--locked .st-ptile-name { color: rgb(166, 186, 198); }
.st .st-ptile-state {
    font-size: 13px; margin-top: 1px; color: rgb(166, 186, 198); white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-ptile-sub { font-size: 12px; margin-top: 1px; color: rgb(166, 186, 198); white-space: normal; }
.st .st-ptile-next { font-size: 12px; margin-top: 1px; color: rgb(164, 210, 232); white-space: normal; }
.st .st-ptile-act { color: rgb(164, 210, 232); }
.st-ptile-bar {
    position: absolute; left: 8px; right: 8px; bottom: 3px; height: 3px;
    border-radius: 2px; background-color: rgb(44, 74, 94); overflow: hidden;
}
.st-ptile-fill { height: 3px; width: 0; background-color: rgb(242, 196, 109); }
.st .st-psum { font-size: 14px; color: rgb(166, 186, 198); margin-top: 8px; white-space: normal; flex-shrink: 0; }

/* --- no farmer: the line and its fix ----------------------------------- */

.st-farmer { border-color: rgb(110, 52, 46); margin-bottom: 8px; padding: 4px 8px 4px 14px; }
.st-farmer-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.st .st-farmer-title {
    font-size: 16px; color: rgb(246, 146, 128); white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-farmer-sub { font-size: 14px; color: rgb(166, 186, 198); margin-top: 1px; white-space: normal; }
.st .st-farmer-btn { min-height: 48px; padding: 0 18px; flex-shrink: 0; }

/* --- the picked plot ------------------------------------------------------ */

.st-pdetail { flex-direction: column; flex-shrink: 0; }
.st-pdetail-head { flex-direction: row; align-items: center; margin-bottom: 8px; flex-shrink: 0; }
.st .st-pback { margin: 0 10px 0 0; padding: 0 14px; min-height: 48px; font-size: 16px; }
.st-pdetail-words { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.st .st-pdetail-title {
    font-size: 18px; white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Nunito-Black.ttf");
}
.st .st-pdetail-state { font-size: 14px; color: rgb(166, 186, 198); margin-top: 1px; white-space: normal; }
.st .st-pinfo { font-size: 14px; color: rgb(166, 186, 198); margin-top: 8px; white-space: normal; flex-shrink: 0; }
.st-pactions { flex-direction: row; align-items: stretch; margin-top: 8px; flex-shrink: 0; }
.st .st-pact {
    flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0;
    margin: 0 0 0 8px; padding: 4px 10px; min-height: 50px; font-size: 16px;
}
.st .st-pact--first { margin-left: 0; }
.st .st-pact--on { background-color: rgb(31, 74, 60); border-color: rgb(156, 210, 122); color: rgb(159, 224, 194); }
.st .st-pact--on:hover { background-color: rgb(38, 88, 70); }
/* the plot card's state takes the tones (after the card's own muted colour) */
.st .st-ptile .st-tone--good { color: rgb(156, 210, 122); }
.st .st-ptile .st-tone--wait { color: rgb(242, 196, 109); }
.st .st-ptile .st-tone--bad { color: rgb(246, 146, 128); }
.st .st-ptile .st-ptile-act { color: rgb(164, 210, 232); }
/* The crop cards in a picked plot: icon 34 beside three lines, the time line
 * at 12 so "10 in 20 min" (71 units) fits the ~75 left beside it. */
.st .st-ptile--crop .st-ptile-icon { width: 34px; height: 34px; margin-right: 4px; }
.st .st-ptile--crop .st-ptile-state { font-size: 12px; }
.st .st-pinfo { font-size: 13px; }
